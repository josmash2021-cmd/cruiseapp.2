# ═══════════════════════════════════════════════════════════════════════
#  CRUISEAPP ENVIRONMENT VARIABLES
#  Copy this file to .env and fill in your actual values
#  NEVER commit .env to git!
# ═══════════════════════════════════════════════════════════════════════

# ── PostgreSQL (Railway Production) ───────────────────────────────────
# Get from: Railway Dashboard → Your Project → PostgreSQL Service → Variables
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:PASSWORD@containers-xxx.railway.app:1234/railway

# ── Supabase PostgreSQL (Alternative/Backup) ──────────────────────────
# Only needed if your Railway app connects to Supabase instead of Railway PG
# Get from: https://supabase.com/dashboard/project/elvszwazwvpgqvnzxwnq/settings/database
SUPABASE_DB_PASSWORD=your_supabase_postgres_password_here

# ── Stripe ────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# ── Firebase (for scripts, not MCP) ───────────────────────────────────
# Get from: Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=backend/config/serviceAccountKey.json

# ── Twilio ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# ── OpenAI ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key

# ── Mapbox ────────────────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token

# ── Railway / Backend ─────────────────────────────────────────────────
RAILWAY_TOKEN=your_railway_api_token
BACKEND_URL=https://cruiseapp2-production.up.railway.app

# ── Checkr ────────────────────────────────────────────────────────────
CHECKR_API_KEY=your_checkr_api_key
