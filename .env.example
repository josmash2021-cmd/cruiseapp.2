# ═══════════════════════════════════════════════════════════════════════
#  CRUISEAPP ENVIRONMENT VARIABLES
#  Copy this file to .env and fill in your actual values
#  NEVER commit .env to git!
# ═══════════════════════════════════════════════════════════════════════

# ── Supabase PostgreSQL (Production Database) ─────────────────────────
# Your backend uses Supabase PostgreSQL in production.
# Local dev uses SQLite (cruise.db).
# Get password from: https://supabase.com/dashboard/project/elvszwazwvpgqvnzxwnq/settings/database
SUPABASE_DB_PASSWORD=your_supabase_postgres_password_here

# ── Stripe ────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
