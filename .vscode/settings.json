{
  // ═══════════════════════════════════════════════════════════════════════
  //  CRUISEAPP MCP SERVERS CONFIGURATION
  //  Model Context Protocol servers for Kimi Code / VS Code
  // ═══════════════════════════════════════════════════════════════════════

  // ── Kimi Code MCP Integration ─────────────────────────────────────────
  "kimi.mcp.servers": {
    
    // ── 1. SUPABASE (PostgreSQL) ── Production Database ────────────────
    // Your backend uses Supabase PostgreSQL as the production database.
    // Local dev uses SQLite, but production data lives in Supabase.
    "cruiseapp-supabase": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@gishubperu/mcp-postgresql",
        "--connection",
        "postgresql://postgres.elvszwazwvpgqvnzxwnq@aws-1-us-east-2.pooler.supabase.com:5432/postgres"
      ],
      "env": {
        "PGPASSWORD": "${env:SUPABASE_DB_PASSWORD}"
      },
      "disabled": false
    },

    // ── 2. STRIPE ── Payment Processing ────────────────────────────────
    "cruiseapp-stripe": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@stripe/mcp",
        "--api-key=${env:STRIPE_SECRET_KEY}"
      ],
      "env": {
        "STRIPE_SECRET_KEY": "${env:STRIPE_SECRET_KEY}"
      },
      "disabled": false
    },

    // ── 3. FILESYSTEM ── Project File Access ───────────────────────────
    "cruiseapp-filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "c:\\Users\\Puma\\cruiseapp.2"
      ],
      "disabled": false
    },

    // ── 4. CONTEXT7 ── Flutter/Dart Documentation ──────────────────────
    // Provides access to Flutter, Dart, and pub.dev package documentation.
    // Useful for: API reference, widget docs, troubleshooting Flutter issues.
    "cruiseapp-context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "disabled": false
    }
  },

  // ═══════════════════════════════════════════════════════════════════════
  //  FIREBASE MCP — NOT AVAILABLE AS STANDALONE SERVER
  // ═══════════════════════════════════════════════════════════════════════
  // There is NO official Firebase/Firestore MCP server available on npm.
  // Use Supabase MCP for database operations (your backend syncs to it).
  // ═══════════════════════════════════════════════════════════════════════

  // ── VS Code General Settings ──────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.rulers": [80, 120],
  "files.exclude": {
    "**/.dart_tool": true,
    "**/build": true,
    "**/.flutter-plugins*": true,
    "**/.packages": true
  }
}
