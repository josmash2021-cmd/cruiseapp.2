<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for Cruise App (PRODUCTION).
  Only HTTPS traffic is allowed. Cleartext (HTTP) is blocked.
  Debug builds use the override in src/debug/res/xml/network_security_config.xml
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
