# ┌─────────────────────────────────────────────────────────────┐
# │  Backend secrets TEMPLATE                                    │
# │  Copy this file to .env and fill in your real values.        │
# │  For Railway: set all vars via the Railway dashboard UI.     │
# └─────────────────────────────────────────────────────────────┘

# ── Core security (required) ──────────────────────────────────
API_KEY=your-api-key-here
HMAC_SECRET=your-hmac-secret-here
JWT_SECRET=your-jwt-secret-here
DISPATCH_API_KEY=your-dispatch-api-key-here

# ── Database (Supabase PostgreSQL) ────────────────────────────
# Local dev: SQLite (default below).
# Production: Set DATABASE_URL to your Supabase connection string.
# The backend resolves in this order:
#   1. DATABASE_PRIVATE_URL
#   2. PGHOST/PGUSER/PGPASSWORD/PGDATABASE/PGPORT
#   3. DATABASE_URL
DATABASE_URL=sqlite+aiosqlite:///./cruise.db

# ── Public URL ────────────────────────────────────────────────
PUBLIC_URL=https://cruiseapp2-production.up.railway.app

# ── Dispatch owner login ──────────────────────────────────────
OWNER_EMAIL=your-email@example.com
OWNER_PASSWORD=your-dispatch-password

# ── Twilio (SMS / OTP) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── EmailJS (email OTP) ───────────────────────────────────────
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxx

# ── Checkr (background checks) ────────────────────────────────
CHECKR_API_KEY=your_checkr_api_key_here
CHECKR_WEBHOOK_SECRET=your_checkr_webhook_secret_here
CHECKR_SANDBOX=true

# ── Stripe (payments) ─────────────────────────────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Dwolla (instant bank cashout - production) ───────────────
DWOLLA_APP_KEY=your_dwolla_app_key_here
DWOLLA_APP_SECRET=your_dwolla_app_secret_here
DWOLLA_ENV=production
# Format: /funding-sources/{id}
DWOLLA_CRUISE_FUNDING_SOURCE=/funding-sources/your-funding-source-id

# ── Firebase (Firestore sync from backend) ────────────────────
# Paste the contents of serviceAccountKey.json as a base64 string:
#   Windows: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
#   Mac/Linux: base64 -i serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=base64-encoded-service-account-json

# ── Google Maps (Directions API) ─────────────────────────────
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI (for AI support chat) ─────────────────────────────
OPENAI_API_KEY=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

# ── SMTP (optional fallback for email) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Cruise App <noreply@cruiseapp.com>

# ── n8n Workflows (automation triggers) ──────────────────────
# Base URL of your n8n instance (e.g., http://localhost:5678 or https://n8n.yourdomain.com)
N8N_BASE_URL=http://localhost:5678
# Optional webhook secret for added security (include in webhook payload as _webhook_secret)
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret-here
# Set to false to disable n8n triggers (useful for local dev without n8n running)
N8N_ENABLED=true
# Timeout in seconds for n8n webhook requests (default: 5)
N8N_TIMEOUT=5

# ── Telegram Bot Alerts (real-time admin notifications) ─────
# Create bot via @BotFather, get chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

