{
  "rules": {
    "chats": {
      "$rideId": {
        "messages": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": ["timestamp", "read"]
        },
        "typing": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "lastMessage": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "lastTimestamp": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "driver_locations": {
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $driverId"
      }
    },
    "drivers": {
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $driverId"
      }
    }
  }
}
