{
  "rules": {
    "ratings": {
      "$collection": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "chats": {
      "$rideId": {
        "messages": {
          ".read": "auth != null",
          ".indexOn": ["timestamp", "read"],
          "$msgId": {
            ".write": "auth != null && (!data.exists() || data.child('senderId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['senderId', 'text', 'timestamp']) && newData.child('senderId').val() === auth.uid"
          }
        },
        "typing": {
          ".read": "auth != null",
          "$role": {
            ".write": "auth != null"
          }
        },
        "lastMessage": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "lastTimestamp": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "driver_locations": {
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $driverId"
      }
    },
    "drivers": {
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $driverId"
      }
    }
  }
}
