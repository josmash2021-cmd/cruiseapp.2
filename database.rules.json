{
  "rules": {
    "ratings": {
      "$collection": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "chats": {
      "$rideId": {
        "messages": {
          ".read": "auth != null",
          ".indexOn": ["timestamp", "read"],
          "$msgId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['senderId', 'text', 'timestamp'])"
          }
        },
        "typing": {
          ".read": "auth != null",
          "$role": {
            ".write": "auth != null"
          }
        },
        "lastMessage": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "lastTimestamp": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "driver_locations": {
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "drivers": {
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
