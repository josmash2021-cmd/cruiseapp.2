rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnDoc(docId) {
      return request.auth != null && request.auth.uid == docId;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Config collection — read-only for all authenticated users
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /verifications/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwnDoc(docId) || isAdmin();
    }

    match /clients/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwnDoc(docId) || isAdmin();
    }

    match /drivers/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOwnDoc(docId) || isAdmin();
    }

    match /trips/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Only the rider (resource owner) or assigned driver may update a trip.
      // Falls back to admin for ops overrides.
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.rider_uid ||
        request.auth.uid == resource.data.driver_uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /users/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() || isAdmin();
      // Only the account owner may update their own profile.
      allow update: if isOwnDoc(docId) || isAdmin();
      allow delete: if isAdmin();

      // Subcollections: only the account owner may write.
      match /{subcollection}/{docId2} {
        allow read: if isAuthenticated();
        allow write: if isOwnDoc(docId) || isAdmin();
      }
    }

    match /riders/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /admins/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
