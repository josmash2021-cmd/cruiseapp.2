rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Config collection — read-only for all authenticated users
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /verifications/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    match /clients/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    match /drivers/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /trips/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /users/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();

      // Subcollections (inbox_chats, etc.)
      match /{subcollection}/{docId2} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    match /riders/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /admins/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Admin alerts from backend (payment, server, security)
    match /admin_alerts/{alertId} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Driver bug reports / feedback
    match /driver_reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
