rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnDoc(docId) {
      return request.auth != null && request.auth.uid == docId;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'royalpurplecorp@gmail.com';
    }

    // Config collection — read-only for all authenticated users
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /verifications/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /clients/{docId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAuthenticated() || isAdmin();
    }
    match /drivers/{docId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAuthenticated() && isOwnDoc(docId) || isAdmin();
    }
    match /trips/{docId} {
      allow read: if isAuthenticated() || isAdmin();
      allow create: if isAuthenticated() || isAdmin();
      allow update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
    }
    match /users/{docId} {
      allow read: if isAuthenticated() || isAdmin();
      allow create: if isAuthenticated() && isOwnDoc(docId) || isAdmin();
      allow update: if isAuthenticated() && isOwnDoc(docId) || isAdmin();
      allow delete: if isAdmin();
    }
    match /riders/{docId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }
    match /admins/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    // Allow all for admin during development
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
