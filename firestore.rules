rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════
    // WHO IS WHO (2026-11-03 hardening, CLAUDE.md #28/#61)
    //
    //   * App users sign in with a backend custom token: uid = 'user_{id}'
    //     (routers/auth.py /auth/firebase-token). Their docs are keyed
    //     'sql_{id}' and trips name them as passengerId 'sql_{id}' and
    //     driverId '{id}' (string or int), so ownership is derived here.
    //   * Panel operators sign in with email/password and each has an
    //     admins/{uid} doc (the panel's login gate refuses anyone without).
    //   * The backend writes with the Admin SDK: rules never apply to it.
    //
    // Before this, almost every rule ended in `|| isAuthenticated()`: any
    // account could read every trip (names, phones, addresses) and write any
    // trip or profile. Party checks come BEFORE isOwnerOrAdmin(): its
    // exists() is a billed read on every request (a driver's location write
    // runs twice a second).
    //
    // Guard: tool/firestore_rules (emulator tests, one per client access).
    // ═══════════════════════════════════════════════════════════════════

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'royalpurplecorp@gmail.com';
    }

    function isAdmin() {
      return request.auth != null
        && (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            || request.auth.token.email == 'royalpurplecorp@gmail.com');
    }

    function isOwnerOrAdmin() {
      return isOwner() || isAdmin();
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // An app account: uid 'user_{digits}'.
    function isAppUser() {
      return request.auth != null && request.auth.uid.matches('user_[0-9]+');
    }

    // '{id}' of an app account, as a string.
    function myNum() {
      return request.auth.uid.replace('user_', '');
    }

    // Its docs: 'sql_{id}'.
    function mySqlId() {
      return 'sql_' + myNum();
    }

    function myInt() {
      return int(myNum());
    }

    // A doc id that is this app account in any of the shapes the app uses
    // (sql_{id} normally; photo_recovery_service also tries user_{id}/{id}).
    function isMyDocId(docId) {
      return isAppUser()
        && (docId == mySqlId() || docId == request.auth.uid || docId == myNum());
    }

    // A profile doc of this account: keyed sql_{id}, or created by the panel
    // under an auto id with sqliteId = {id}.
    function isMyProfile(docId, data) {
      return isMyDocId(docId)
        || (isAppUser() && data.get('sqliteId', -1) == myInt());
    }

    // The write touches only these fields.
    function onlyChanges(keys) {
      return request.resource.data.diff(
          resource == null ? {} : resource.data).affectedKeys().hasOnly(keys);
    }

    // ═══════════════════════════════════════════════════════════════════
    // CONFIG — admin-controlled (pricing, service zones, app mode)
    // ═══════════════════════════════════════════════════════════════════
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // VERIFICATIONS — identity verification documents
    // Only the backend and the panel write them: an app-created
    // "approved" verification is what the server used to copy into the
    // account (#61).
    // ═══════════════════════════════════════════════════════════════════
    match /verifications/{docId} {
      // userId is the backend's INT id (some old docs carry the 'user_{id}'
      // string); a missing doc reveals nothing.
      allow get: if resource == null
        || isMyDocId(docId)
        || (isAppUser() && (resource.data.get('userId', null) == myInt()
                            || resource.data.get('userId', null) == request.auth.uid))
        || isOwnerOrAdmin();
      // The app's query is where('userId', isEqualTo: <int>).
      allow list: if (isAppUser() && resource.data.userId == myInt())
        || isOwnerOrAdmin();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // ADMINS — owner can create/update/delete; admins can read
    // ═══════════════════════════════════════════════════════════════════
    match /admins/{adminId} {
      allow read: if isOwnerOrAdmin();
      allow create: if isOwner();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    // ═══════════════════════════════════════════════════════════════════
    // TRIPS — trips/sql_{id}, mirrored by the backend
    // ═══════════════════════════════════════════════════════════════════

    function isTripRider(d) {
      return isAppUser() && d.get('passengerId', '') == mySqlId();
    }

    // The driver the backend assigned (driverId / driver_id), or one it
    // granted (accessUids — written before the accept answer, so his
    // listener is never denied while the mirror catches up, and kept after
    // a reassign so his app can read releasedAt and leave).
    function isTripDriver(d) {
      return isAppUser()
        && (request.auth.uid in d.get('accessUids', [])
            || string(d.get('driverId', '')) == myNum()
            || string(d.get('driver_id', '')) == myNum());
    }

    // An approved driver account (server-written; the app cannot write it).
    function isApprovedDriver() {
      return isAppUser()
        && exists(/databases/$(database)/documents/drivers/$(mySqlId()))
        && (get(/databases/$(database)/documents/drivers/$(mySqlId())).data.get('isApproved', false) == true
            || get(/databases/$(database)/documents/drivers/$(mySqlId())).data.get('approvalStatus', '') == 'approved');
    }

    match /trips/{tripId} {
      // A doc that does not exist yet reveals nothing — the rider's
      // listener is armed right after the request, before the mirror.
      allow get: if resource == null
        || isTripRider(resource.data)
        || isTripDriver(resource.data)
        || isOwnerOrAdmin();
      // TEMPORARY (phase 1): driver builds before 757 look for their active
      // trip with a query across ALL active trips
      // (driver_online_offline._refreshActiveTripStatus); denied, a resumed
      // trip never restarts the offer polling. 757 asks the server instead.
      // Drop isApprovedDriver() here once no driver runs a build < 757.
      allow list: if isOwnerOrAdmin() || isApprovedDriver();
      // Client creates are dead code; the backend creates every trip doc.
      allow create: if isOwnerOrAdmin();
      // The driver writes status, his position, his card, the rider's
      // rating and route proposals — never who the trip belongs to, who may
      // read it, the price or the pickup code.
      allow update: if (isTripDriver(resource.data)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                 'passengerId', 'passengerName', 'passengerPhone', 'accessUids',
                 'sqliteId', 'fare', 'pickup_pin', 'paymentMethod',
                 'pickupAddress', 'pickupLat', 'pickupLng',
                 'dropoffAddress', 'dropoffLat', 'dropoffLng',
                 'vehicleType', 'isScheduled', 'scheduledAt', 'createdAt', 'source']))
        // The rider only answers a route proposal.
        || (isTripRider(resource.data) && onlyChanges(['pending_route_change']))
        || isOwnerOrAdmin();
      allow delete: if isOwnerOrAdmin();

      // Rider/driver misconduct reports filed from the driver app
      // (driver_trip_accept_screen._submitReport). Subcollection rules are
      // NOT inherited from the parent document.
      match /reports/{reportId} {
        allow read: if isOwnerOrAdmin();
        allow create: if isTripDriver(get(/databases/$(database)/documents/trips/$(tripId)).data)
          || isOwnerOrAdmin();
        allow update, delete: if isOwnerOrAdmin();
      }
    }

    // ═══════════════════════════════════════════════════════════════════
    // USERS — users/sql_{id}: photo, notification prefs, approval mirror
    // ═══════════════════════════════════════════════════════════════════
    match /users/{userId} {
      // TEMPORARY (phase 1): either party of a trip reads the other's
      // photoUrl here (photo_recovery_service), and the rules cannot see
      // who rode with whom. Single docs only; listing is the panel's.
      allow get: if isAuthenticated();
      allow list: if isOwnerOrAdmin();
      // The app writes its own photo and notification prefs, nothing else
      // (the approval fields here are the backend's).
      allow create, update: if (isMyDocId(userId)
            && onlyChanges(['photoUrl', 'photoUpdatedAt', 'notificationPrefs',
                            'lastUpdated', 'updatedAt']))
        || isOwnerOrAdmin();
      allow delete: if isOwnerOrAdmin();

      match /payment_methods/{methodId} {
        allow read, write: if isMyDocId(userId) || isOwnerOrAdmin();
      }

      match /notifications/{notificationId} {
        allow read: if isMyDocId(userId) || isOwnerOrAdmin();
        allow write: if isOwnerOrAdmin();
      }

      // Archived trip chats shown in the rider inbox
      // (rider_tracking_controller writes users/sql_{id}/inbox_chats/{tripId}).
      match /inbox_chats/{chatId} {
        allow read, write: if isMyDocId(userId) || isOwnerOrAdmin();
      }
    }

    // ═══════════════════════════════════════════════════════════════════
    // CLIENTS / DRIVERS — profiles (panel + backend). The app reads its own
    // and sets its own photo; status and approval are the backend's.
    // ═══════════════════════════════════════════════════════════════════
    match /clients/{clientId} {
      allow get: if isMyProfile(clientId, resource.data) || isOwnerOrAdmin();
      // firebase_storage_service: where('sqliteId', isEqualTo: <my id>).
      allow list: if (isAppUser() && resource.data.sqliteId == myInt())
        || isOwnerOrAdmin();
      allow update: if (isMyProfile(clientId, resource.data)
            && onlyChanges(['photoUrl', 'photoUpdatedAt', 'lastUpdated', 'updatedAt']))
        || isOwnerOrAdmin();
      allow create, delete: if isOwnerOrAdmin();

      match /payment_methods/{methodId} {
        allow read, write: if isMyDocId(clientId) || isOwnerOrAdmin();
      }
      match /notifications/{notificationId} {
        allow read: if isMyDocId(clientId) || isOwnerOrAdmin();
        allow write: if isOwnerOrAdmin();
      }
    }

    match /drivers/{driverId} {
      allow get: if isMyProfile(driverId, resource.data) || isOwnerOrAdmin();
      allow list: if (isAppUser() && resource.data.sqliteId == myInt())
        || isOwnerOrAdmin();
      allow update: if (isMyProfile(driverId, resource.data)
            && onlyChanges(['photoUrl', 'photoUpdatedAt', 'lastUpdated', 'updatedAt']))
        || isOwnerOrAdmin();
      allow create, delete: if isOwnerOrAdmin();

      match /payment_methods/{methodId} {
        allow read, write: if isMyDocId(driverId) || isOwnerOrAdmin();
      }
      match /notifications/{notificationId} {
        allow read: if isMyDocId(driverId) || isOwnerOrAdmin();
        allow write: if isOwnerOrAdmin();
      }
    }

    // ═══════════════════════════════════════════════════════════════════
    // PANEL-ONLY — no app build reads or writes these (inventory
    // 2026-11-03); the backend writes them with the Admin SDK.
    // ═══════════════════════════════════════════════════════════════════

    // Append-only.
    match /audit_log/{logId} {
      allow read, create: if isOwnerOrAdmin();
      allow update, delete: if false;
    }

    match /scheduled_rides/{rideId} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /dispatch_driver_chats/{driverId} {
      allow read, write: if isOwnerOrAdmin();
      match /messages/{messageId} {
        allow read, write: if isOwnerOrAdmin();
      }
    }

    match /dispatch_notifications/{notifId} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /driver_reports/{reportId} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /support_chats/{chatId} {
      allow read, write: if isOwnerOrAdmin();
      match /messages/{messageId} {
        allow read, write: if isOwnerOrAdmin();
      }
    }

    match /account_appeals/{appealId} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /admin_alerts/{alertId} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /trip_chats/{tripId} {
      allow read, write: if isOwnerOrAdmin();
      match /messages/{messageId} {
        allow read, write: if isOwnerOrAdmin();
      }
    }

    match /dispatch_chat_rooms/{roomId} {
      allow read, write: if isOwnerOrAdmin();
      match /messages/{messageId} {
        allow read, write: if isOwnerOrAdmin();
      }
    }

    match /payouts/{payoutId} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /promo_codes/{promoId} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /notification_history/{notifId} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /trip_offers/{offerId} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /driver_sessions/{sessionId} {
      allow read, write: if isOwnerOrAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // DENY ALL — everything else blocked
    // ═══════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
