rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnDoc(docId) {
      return request.auth != null && request.auth.uid == docId;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Config collection — read-only for all authenticated users
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /verifications/{docId} {
      allow read: if isOwnDoc(docId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwnDoc(docId) || isAdmin();
    }

    match /clients/{docId} {
      allow read: if isOwnDoc(docId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwnDoc(docId) || isAdmin();
    }

    match /drivers/{docId} {
      // Drivers can read their own doc; riders can read assigned driver during trip
      allow read: if isOwnDoc(docId) || isAdmin() || isAuthenticated();
      allow write: if isOwnDoc(docId) || isAdmin();
    }

    match /trips/{docId} {
      // Only trip participants (rider or driver) can read the trip
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.rider_uid ||
        request.auth.uid == resource.data.driver_uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.rider_uid ||
        request.auth.uid == resource.data.driver_uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /users/{docId} {
      // Users can only read their own profile
      allow read: if isOwnDoc(docId) || isAdmin();
      allow create: if isAuthenticated() || isAdmin();
      allow update: if isOwnDoc(docId) || isAdmin();
      allow delete: if isAdmin();

      // Subcollections: only the account owner may read/write.
      match /{subcollection}/{docId2} {
        allow read: if isOwnDoc(docId) || isAdmin();
        allow write: if isOwnDoc(docId) || isAdmin();
      }
    }

    match /riders/{docId} {
      allow read: if isOwnDoc(docId) || isAdmin();
      allow write: if isAdmin();
    }

    match /admins/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Admin alerts from backend (payment, server, security)
    match /admin_alerts/{alertId} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
