{
  "name": "Cruise - Payment Failed",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "payment-failed",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook - Payment Failed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.all()[0].json;\n\nif (!data.trip_id || !data.rider_id) {\n  throw new Error('Missing required fields: trip_id, rider_id');\n}\n\nreturn [{\n  json: {\n    trip_id: data.trip_id,\n    rider_id: data.rider_id,\n    rider_name: data.rider_name || 'Rider',\n    rider_email: data.rider_email || '',\n    rider_phone: data.rider_phone || '',\n    fare: (data.fare || 0).toFixed(2),\n    error_code: data.error_code || 'card_declined',\n    error_message: data.error_message || 'Payment could not be processed',\n    stripe_error: data.stripe_error || '',\n    attempt_number: data.attempt_number || 1,\n    max_retries: 3,\n    should_retry: (data.attempt_number || 1) < 3,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "process-failure",
      "name": "Process Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "={{$env.CRUISE_BACKEND_URL}}/internal/push-notification",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{$env.INTERNAL_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"user_id\": {{ $json.rider_id }},\n  \"title\": \"Payment Issue - ${{ $json.fare }}\",\n  \"body\": \"We couldn't process your payment for trip #{{ $json.trip_id }}. Please update your payment method.\",\n  \"data\": {\n    \"type\": \"payment_failed\",\n    \"trip_id\": \"{{ $json.trip_id }}\",\n    \"amount\": \"{{ $json.fare }}\"\n  }\n}",
        "options": {}
      },
      "id": "push-rider",
      "name": "Push to Rider",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 200]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.should_retry }}",
              "value2": true
            }
          ]
        }
      },
      "id": "should-retry",
      "name": "Should Retry?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 400]
    },
    {
      "parameters": {
        "url": "={{$env.CRUISE_BACKEND_URL}}/internal/retry-charge",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{$env.INTERNAL_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"trip_id\": {{ $json.trip_id }},\n  \"attempt_number\": {{ $json.attempt_number + 1 }}\n}",
        "options": {}
      },
      "id": "retry-charge",
      "name": "Schedule Retry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 350]
    },
    {
      "parameters": {
        "url": "={{$env.TWILIO_SMS_URL}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Basic {{$env.TWILIO_AUTH_HEADER}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "To",
              "value": "={{$env.ADMIN_PHONE}}"
            },
            {
              "name": "From",
              "value": "={{$env.TWILIO_PHONE}}"
            },
            {
              "name": "Body",
              "value": "=ALERT: Payment failed for trip #{{ $json.trip_id }}. Rider: {{ $json.rider_name }}. Amount: ${{ $json.fare }}. Error: {{ $json.error_code }}. Attempts exhausted."
            }
          ]
        },
        "options": {}
      },
      "id": "sms-admin",
      "name": "SMS Admin Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 500]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    status: 'handled',\n    trip_id: $json.trip_id,\n    rider_notified: true,\n    retried: $json.should_retry,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "log-result",
      "name": "Log Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 400]
    }
  ],
  "connections": {
    "Webhook - Payment Failed": {
      "main": [
        [
          {
            "node": "Process Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Failure": {
      "main": [
        [
          {
            "node": "Push to Rider",
            "type": "main",
            "index": 0
          },
          {
            "node": "Should Retry?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should Retry?": {
      "main": [
        [
          {
            "node": "Schedule Retry",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "SMS Admin Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Push to Rider": {
      "main": [
        [
          {
            "node": "Log Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule Retry": {
      "main": [
        [
          {
            "node": "Log Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SMS Admin Alert": {
      "main": [
        [
          {
            "node": "Log Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "cruise",
      "id": "1"
    }
  ],
  "triggerCount": 1,
  "pinData": {}
}
