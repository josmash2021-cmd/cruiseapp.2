{
  "name": "Cruise - Daily Admin Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Daily at 8:00 AM UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 400]
    },
    {
      "parameters": {
        "jsCode": "// Calculate yesterday's date range\nconst now = new Date();\nconst yesterday = new Date(now);\nyesterday.setDate(yesterday.getDate() - 1);\n\nconst startDate = new Date(yesterday.setHours(0, 0, 0, 0)).toISOString();\nconst endDate = new Date(yesterday.setHours(23, 59, 59, 999)).toISOString();\n\nreturn [{ json: { startDate, endDate, reportDate: yesterday.toISOString().split('T')[0] } }];"
      },
      "id": "calculate-dates",
      "name": "Calculate Date Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 400]
    },
    {
      "parameters": {
        "url": "={{$env.BACKEND_URL}}/admin/metrics/trips?start={{$json.startDate}}&end={{$json.endDate}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-trips",
      "name": "Get Trips Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Backend API Key"
        }
      }
    },
    {
      "parameters": {
        "url": "={{$env.BACKEND_URL}}/admin/metrics/revenue?start={{$json.startDate}}&end={{$json.endDate}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-revenue",
      "name": "Get Revenue Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Backend API Key"
        }
      }
    },
    {
      "parameters": {
        "url": "={{$env.BACKEND_URL}}/admin/metrics/users?start={{$json.startDate}}&end={{$json.endDate}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-users",
      "name": "Get New Users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 500],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Backend API Key"
        }
      }
    },
    {
      "parameters": {
        "url": "={{$env.BACKEND_URL}}/admin/metrics/drivers?start={{$json.startDate}}&end={{$json.endDate}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-drivers",
      "name": "Get New Drivers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 600],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Backend API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Merge all metrics data\nconst items = $input.all();\n\nconst metrics = {\n  reportDate: items[0].json.reportDate || new Date().toISOString().split('T')[0],\n  trips: {\n    total: items[0].json.total_trips || 0,\n    completed: items[0].json.completed_trips || 0,\n    cancelled: items[0].json.cancelled_trips || 0,\n    cancelled_by_rider: items[0].json.cancelled_by_rider || 0,\n    cancelled_by_driver: items[0].json.cancelled_by_driver || 0,\n    average_rating: items[0].json.average_rating || 0\n  },\n  revenue: {\n    total: items[1].json.total_revenue || 0,\n    gross: items[1].json.gross_revenue || 0,\n    net: items[1].json.net_revenue || 0,\n    driver_earnings: items[1].json.driver_earnings || 0,\n    platform_fee: items[1].json.platform_fee || 0\n  },\n  users: {\n    new: items[2].json.new_users || 0,\n    active: items[2].json.active_users || 0,\n    total: items[2].json.total_users || 0\n  },\n  drivers: {\n    new: items[3].json.new_drivers || 0,\n    active: items[3].json.active_drivers || 0,\n    total: items[3].json.total_drivers || 0,\n    average_rating: items[3].json.average_driver_rating || 0\n  }\n};\n\nreturn [{ json: metrics }];"
      },
      "id": "merge-metrics",
      "name": "Merge Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 400]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.all()[0].json;\n\nconst formatCurrency = (amount) => {\n  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount);\n};\n\nconst formatNumber = (num) => {\n  return new Intl.NumberFormat('en-US').format(num);\n};\n\nconst getChangeIndicator = (current, previous) => {\n  if (!previous || previous === 0) return '';\n  const change = ((current - previous) / previous * 100).toFixed(1);\n  if (change > 0) return `<span style=\"color: #28a745;\">↗ +${change}%</span>`;\n  if (change < 0) return `<span style=\"color: #dc3545;\">↘ ${change}%</span>`;\n  return '<span style=\"color: #999;\">→ 0%</span>';\n};\n\nconst htmlContent = `\n<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: 'Helvetica Neue', Arial, sans-serif; background-color: #f4f4f4; margin: 0; padding: 0; }\n    .container { max-width: 700px; margin: 40px auto; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.1); }\n    .header { background: linear-gradient(135deg, #1a1a1a 0%, #333 100%); padding: 30px; text-align: center; color: white; }\n    .header h1 { margin: 0 0 10px 0; font-size: 28px; }\n    .header .date { font-size: 16px; opacity: 0.9; }\n    .content { padding: 30px; }\n    .section { margin-bottom: 30px; }\n    .section-title { font-size: 18px; font-weight: 700; color: #333; margin-bottom: 15px; padding-bottom: 10px; border-bottom: 2px solid #FFD700; }\n    .metrics-grid { display: table; width: 100%; border-collapse: collapse; }\n    .metric-row { display: table-row; }\n    .metric-label { display: table-cell; padding: 12px; border-bottom: 1px solid #eee; color: #666; font-size: 14px; }\n    .metric-value { display: table-cell; padding: 12px; border-bottom: 1px solid #eee; text-align: right; font-weight: 600; color: #333; font-size: 16px; }\n    .highlight { background: #fff8e1; padding: 20px; border-radius: 6px; border-left: 4px solid #FFD700; margin: 20px 0; }\n    .highlight .big-number { font-size: 32px; font-weight: 700; color: #333; margin: 10px 0; }\n    .footer { background: #f9f9f9; padding: 20px 30px; text-align: center; color: #999; font-size: 12px; border-top: 1px solid #eee; }\n    .badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; margin-left: 8px; }\n    .badge-success { background: #d4edda; color: #155724; }\n    .badge-warning { background: #fff3cd; color: #856404; }\n    .badge-danger { background: #f8d7da; color: #721c24; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>📊 Reporte Diario de Cruise</h1>\n      <div class=\"date\">Datos del ${data.reportDate}</div>\n    </div>\n    <div class=\"content\">\n      <div class=\"highlight\">\n        <div style=\"font-size: 14px; color: #666; margin-bottom: 5px;\">Revenue Total del Día</div>\n        <div class=\"big-number\">${formatCurrency(data.revenue.total)}</div>\n        <div style=\"font-size: 14px; color: #666;\">Net Revenue: ${formatCurrency(data.revenue.net)}</div>\n      </div>\n\n      <div class=\"section\">\n        <div class=\"section-title\">🚗 Viajes</div>\n        <div class=\"metrics-grid\">\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">Total de viajes</div>\n            <div class=\"metric-value\">${formatNumber(data.trips.total)}</div>\n          </div>\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">Completados</div>\n            <div class=\"metric-value\">${formatNumber(data.trips.completed)}\n              ${data.trips.total > 0 ? `<span class=\"badge badge-success\">${((data.trips.completed / data.trips.total) * 100).toFixed(1)}%</span>` : ''}\n            </div>\n          </div>\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">Cancelados</div>\n            <div class=\"metric-value\">${formatNumber(data.trips.cancelled)}\n              ${data.trips.total > 0 ? `<span class=\"badge badge-warning\">${((data.trips.cancelled / data.trips.total) * 100).toFixed(1)}%</span>` : ''}\n            </div>\n          </div>\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">• Por riders</div>\n            <div class=\"metric-value\">${formatNumber(data.trips.cancelled_by_rider)}</div>\n          </div>\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">• Por drivers</div>\n            <div class=\"metric-value\">${formatNumber(data.trips.cancelled_by_driver)}</div>\n          </div>\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">Rating promedio</div>\n            <div class=\"metric-value\">${data.trips.average_rating.toFixed(2)} ⭐</div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"section\">\n        <div class=\"section-title\">💰 Revenue Breakdown</div>\n        <div class=\"metrics-grid\">\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">Gross Revenue</div>\n            <div class=\"metric-value\">${formatCurrency(data.revenue.gross)}</div>\n          </div>\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">Driver Earnings (80%)</div>\n            <div class=\"metric-value\">${formatCurrency(data.revenue.driver_earnings)}</div>\n          </div>\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">Platform Fee (20%)</div>\n            <div class=\"metric-value\">${formatCurrency(data.revenue.platform_fee)}</div>\n          </div>\n          <div class=\"metric-row\" style=\"font-weight: 700; background: #f9f9f9;\">\n            <div class=\"metric-label\">Net Revenue</div>\n            <div class=\"metric-value\" style=\"color: #28a745;\">${formatCurrency(data.revenue.net)}</div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"section\">\n        <div class=\"section-title\">👥 Usuarios</div>\n        <div class=\"metrics-grid\">\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">Nuevos registros</div>\n            <div class=\"metric-value\">${formatNumber(data.users.new)}</div>\n          </div>\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">Usuarios activos</div>\n            <div class=\"metric-value\">${formatNumber(data.users.active)}</div>\n          </div>\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">Total usuarios</div>\n            <div class=\"metric-value\">${formatNumber(data.users.total)}</div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"section\">\n        <div class=\"section-title\">🚕 Drivers</div>\n        <div class=\"metrics-grid\">\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">Nuevos drivers</div>\n            <div class=\"metric-value\">${formatNumber(data.drivers.new)}</div>\n          </div>\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">Drivers activos</div>\n            <div class=\"metric-value\">${formatNumber(data.drivers.active)}</div>\n          </div>\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">Total drivers</div>\n            <div class=\"metric-value\">${formatNumber(data.drivers.total)}</div>\n          </div>\n          <div class=\"metric-row\">\n            <div class=\"metric-label\">Rating promedio drivers</div>\n            <div class=\"metric-value\">${data.drivers.average_rating.toFixed(2)} ⭐</div>\n          </div>\n        </div>\n      </div>\n\n      ${data.trips.cancelled > 10 ? `\n      <div style=\"background: #fff3cd; padding: 15px; border-radius: 6px; border-left: 4px solid #ffc107; margin: 20px 0;\">\n        ⚠️ <strong>Atención:</strong> Alto número de cancelaciones hoy (${data.trips.cancelled}). Revisar causas.\n      </div>\n      ` : ''}\n\n    </div>\n    <div class=\"footer\">\n      Este reporte fue generado automáticamente por n8n<br>\n      © 2026 Cruise App - Admin Dashboard\n    </div>\n  </div>\n</body>\n</html>\n`;\n\nreturn [{ json: { ...data, html: htmlContent, subject: `📊 Cruise Daily Report - ${data.reportDate}` } }];"
      },
      "id": "build-report",
      "name": "Build HTML Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.SMTP_FROM_EMAIL || 'reports@cruise.app'}}",
        "toEmail": "={{$env.ADMIN_EMAIL || 'admin@cruise.app'}}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.html }}",
        "options": {
          "senderName": "Cruise Analytics"
        }
      },
      "id": "send-report",
      "name": "Send Report to Admin",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1250, 400],
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "SMTP Account"
        }
      }
    }
  ],
