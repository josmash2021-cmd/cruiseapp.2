{
  "name": "Cruise - Driver Onboarding",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-driver",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook - New Driver",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 400]
    },
    {
      "parameters": {
        "jsCode": "// Extract driver data\nconst data = $input.all()[0].json;\n\n// Validate required fields\nif (!data.name || !data.email || !data.driver_id) {\n  throw new Error('Missing required fields: name, email, driver_id');\n}\n\n// Prepare driver onboarding data\nconst driverData = {\n  name: data.name,\n  email: data.email,\n  driver_id: data.driver_id,\n  timestamp: new Date().toISOString()\n};\n\nreturn [{ json: driverData }];"
      },
      "id": "process-driver",
      "name": "Process Driver Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 400]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.all()[0].json;\n\nconst htmlContent = `\n<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: 'Helvetica Neue', Arial, sans-serif; background-color: #f4f4f4; margin: 0; padding: 0; }\n    .container { max-width: 600px; margin: 40px auto; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }\n    .header { background: linear-gradient(135deg, #1a1a1a 0%, #333 100%); padding: 40px 30px; text-align: center; color: #FFD700; }\n    .header h1 { margin: 0; font-size: 28px; font-weight: 700; }\n    .content { padding: 40px 30px; }\n    .greeting { font-size: 20px; color: #333; margin-bottom: 20px; }\n    .message { font-size: 16px; color: #555; line-height: 1.6; margin-bottom: 25px; }\n    .checklist { margin: 30px 0; }\n    .checklist-item { display: flex; margin-bottom: 20px; padding: 15px; background: #f9f9f9; border-radius: 6px; border-left: 4px solid #FFD700; }\n    .checkbox { color: #FFD700; font-size: 24px; margin-right: 15px; }\n    .item-content h3 { margin: 0 0 5px 0; color: #333; font-size: 16px; }\n    .item-content p { margin: 0; color: #666; font-size: 14px; }\n    .cta-button { display: inline-block; padding: 16px 40px; background: #FFD700; color: #1a1a1a; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; margin: 20px 0; }\n    .highlight-box { padding: 20px; background: #fff8e1; border-radius: 6px; border-left: 4px solid #FFA500; margin: 25px 0; }\n    .footer { background: #f9f9f9; padding: 30px; text-align: center; border-top: 1px solid #eee; color: #999; font-size: 12px; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>🚗 ¡Bienvenido al Equipo de Drivers!</h1>\n    </div>\n    <div class=\"content\">\n      <div class=\"greeting\">Hola ${data.name},</div>\n      <div class=\"message\">\n        ¡Estamos emocionados de que formes parte de Cruise! Para empezar a conducir y ganar dinero, necesitamos que completes tu documentación.\n      </div>\n      <div class=\"message\">\n        <strong>📋 Documentos Requeridos:</strong>\n      </div>\n      <div class=\"checklist\">\n        <div class=\"checklist-item\">\n          <div class=\"checkbox\">☐</div>\n          <div class=\"item-content\">\n            <h3>Licencia de Conducir</h3>\n            <p>Foto clara de ambos lados. Debe estar vigente y ser válida en tu país.</p>\n          </div>\n        </div>\n        <div class=\"checklist-item\">\n          <div class=\"checkbox\">☐</div>\n          <div class=\"item-content\">\n            <h3>Seguro del Vehículo</h3>\n            <p>Póliza vigente a tu nombre o con tu nombre como conductor autorizado.</p>\n          </div>\n        </div>\n        <div class=\"checklist-item\">\n          <div class=\"checkbox\">☐</div>\n          <div class=\"item-content\">\n            <h3>Registro Vehicular</h3>\n            <p>Tarjeta de circulación o documento de propiedad del vehículo.</p>\n          </div>\n        </div>\n        <div class=\"checklist-item\">\n          <div class=\"checkbox\">☐</div>\n          <div class=\"item-content\">\n            <h3>Background Check</h3>\n            <p>Verificación de antecedentes penales (se procesa automáticamente).</p>\n          </div>\n        </div>\n      </div>\n      <div class=\"highlight-box\">\n        <strong>⏱️ Tiempo estimado:</strong> 5-10 minutos<br>\n        <strong>📱 Tip:</strong> Podés subir todo desde la app móvil usando tu cámara.\n      </div>\n      <div style=\"text-align: center;\">\n        <a href=\"https://cruise.app/driver/documents/${data.driver_id}\" class=\"cta-button\">Subir Documentos Ahora</a>\n      </div>\n      <div class=\"message\" style=\"margin-top: 30px;\">\n        Una vez que revisemos tu documentación (usualmente en 24-48 horas), te enviaremos un email de aprobación y podrás empezar a recibir solicitudes de viaje.\n      </div>\n    </div>\n    <div class=\"footer\">\n      ¿Necesitás ayuda? Escribinos a support@cruise.app<br>\n      © 2026 Cruise App. Todos los derechos reservados.\n    </div>\n  </div>\n</body>\n</html>\n`;\n\nreturn [{ json: { ...data, html: htmlContent, subject: `¡Empecemos, ${data.name}! Documentos requeridos 📄` } }];"
      },
      "id": "build-initial-email",
      "name": "Build Initial Email",
