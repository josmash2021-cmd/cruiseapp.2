      "parameters": {
        "jsCode": "const data = $input.all()[0].json;\n\nconst htmlContent = `\n<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; background-color: #f4f4f4; margin: 0; padding: 0; }\n    .container { max-width: 600px; margin: 40px auto; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }\n    .header { background: linear-gradient(135deg, #28a745 0%, #20c997 100%); padding: 40px 30px; text-align: center; color: white; }\n    .header h1 { margin: 0; font-size: 28px; }\n    .content { padding: 40px 30px; }\n    .message { font-size: 16px; color: #555; line-height: 1.6; margin-bottom: 20px; }\n    .success-box { background: #d4edda; padding: 20px; border-radius: 6px; border-left: 4px solid #28a745; margin: 25px 0; color: #155724; }\n    .cta-button { display: inline-block; padding: 16px 40px; background: #28a745; color: white; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; margin: 20px 0; }\n    .tips { background: #f9f9f9; padding: 20px; border-radius: 6px; margin: 25px 0; }\n    .tips h3 { margin-top: 0; color: #333; }\n    .tips ul { margin: 0; padding-left: 20px; }\n    .tips li { margin-bottom: 10px; color: #555; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>🎉 ¡Estás Aprobado!</h1>\n    </div>\n    <div class=\"content\">\n      <div class=\"message\">Hola ${data.name},</div>\n      <div class=\"success-box\">\n        <strong>✅ ¡Felicitaciones!</strong> Tu documentación ha sido aprobada y estás listo para empezar a conducir con Cruise.\n      </div>\n      <div class=\"message\">\n        A partir de ahora podés activar el modo \"Disponible\" en la app y empezar a recibir solicitudes de viaje en tiempo real.\n      </div>\n      <div style=\"text-align: center;\">\n        <a href=\"https://cruise.app/driver\" class=\"cta-button\">Empezar a Conducir 🚗</a>\n      </div>\n      <div class=\"tips\">\n        <h3>💡 Tips para tu primer día:</h3>\n        <ul>\n          <li>Mantené tu vehículo limpio y con suficiente combustible</li>\n          <li>Guardá agua y snacks para pasajeros (aumenta tus ratings)</li>\n          <li>Confirmá siempre el nombre del pasajero antes de iniciar el viaje</li>\n          <li>Usá Google Maps o Waze junto con la navegación de Cruise</li>\n          <li>Sé amable, puntual y profesional para obtener 5 estrellas ⭐</li>\n        </ul>\n      </div>\n      <div class=\"message\">\n        <strong>Tus ganancias:</strong> Cobrás el 80% de cada viaje + el 100% de las propinas. Los pagos se procesan semanalmente cada lunes.\n      </div>\n      <div class=\"message\" style=\"margin-top: 30px; padding: 15px; background: #fff8e1; border-radius: 6px;\">\n        🎁 <strong>Bono de bienvenida:</strong> Completá 10 viajes en tu primera semana y recibí $50 USD extra.\n      </div>\n    </div>\n  </div>\n</body>\n</html>\n`;\n\nreturn [{ json: { ...data, html: htmlContent, subject: '🎉 ¡Aprobado! Empezá a conducir con Cruise' } }];"
