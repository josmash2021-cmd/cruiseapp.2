    {
      "parameters": {
        "url": "={{$env.BACKEND_URL}}/drivers/{{$json.driver_id}}/documents/status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "check-docs-status-1",
      "name": "Check Documents Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1250, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Backend API Key"
