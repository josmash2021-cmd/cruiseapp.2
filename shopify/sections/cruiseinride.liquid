{% comment %} CruiseInRide — Link in Bio (cruiseinride.vercel.app clone) {% endcomment %}

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
a{text-decoration:none;color:inherit}
img,video{display:block;max-width:100%}

/* ─── PAGE WRAPPER ─── */
.cir{
  position:relative;
  min-height:100vh;
  width:100%;
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  background:#080808;
  overflow-x:hidden;
}

/* ─── VIDEO / PHOTO BACKGROUND ─── */
.cir__bg{
  position:fixed;
  inset:0;
  z-index:0;
  overflow:hidden;
}
.cir__bg-video{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center;
}
.cir__bg-img{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center top;
}
.cir__bg-overlay{
  position:absolute;
  inset:0;
  background:linear-gradient(
    to bottom,
    rgba(0,0,0,0.55) 0%,
    rgba(0,0,0,0.62) 40%,
    rgba(0,0,0,0.75) 100%
  );
}

/* ─── SCROLL BODY ─── */
.cir__body{
  position:relative;
  z-index:1;
  max-width:460px;
  margin:0 auto;
  padding:60px 20px 80px;
  display:flex;
  flex-direction:column;
  align-items:center;
}

/* ─── KEYFRAMES ─── */
@keyframes cir-fadeup{
  from{opacity:0;transform:translateY(22px)}
  to{opacity:1;transform:translateY(0)}
}
@keyframes cir-fadein{
  from{opacity:0}
  to{opacity:1}
}
@keyframes cir-pulse-ring{
  0%,100%{box-shadow:0 0 0 0 rgba(201,168,76,0.35)}
  50%{box-shadow:0 0 0 8px rgba(201,168,76,0)}
}

/* ─── BRAND ─── */
.cir__brand{
  display:flex;
  align-items:center;
  gap:14px;
  margin-bottom:10px;
  animation:cir-fadeup .7s ease both;
}
.cir__logo{
  width:54px;
  height:54px;
  border-radius:50%;
  object-fit:contain;
  animation:cir-pulse-ring 2.5s ease-in-out infinite;
}
.cir__logo-icon{
  width:54px;
  height:54px;
  border-radius:50%;
  background:linear-gradient(145deg,#b8920a,#f2d060);
  display:flex;
  align-items:center;
  justify-content:center;
  border:2px solid rgba(255,255,255,0.15);
  flex-shrink:0;
  color:#111;
  animation:cir-pulse-ring 2.5s ease-in-out infinite;
}
.cir__logo-icon svg{width:28px;height:28px}
.cir__name{
  font-size:2.4rem;
  font-weight:900;
  color:#ffffff;
  letter-spacing:7px;
  text-transform:uppercase;
  line-height:1;
}

/* ─── TAGLINE ─── */
.cir__tagline{
  font-size:0.58rem;
  font-weight:700;
  letter-spacing:5px;
  color:rgba(255,255,255,0.42);
  text-transform:uppercase;
  margin-bottom:32px;
  text-align:center;
  animation:cir-fadeup .8s .1s ease both;
}

/* ─── SECTION DIVIDER ─── */
.cir__divider{
  width:100%;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  margin:20px 0 13px;
  font-size:0.52rem;
  font-weight:700;
  letter-spacing:4px;
  color:rgba(255,255,255,0.32);
  text-transform:uppercase;
}
.cir__divider::before,
.cir__divider::after{
  content:'';
  flex:1;
  height:1px;
  background:rgba(255,255,255,0.07);
}
.cir__divider-dot{
  color:#c9a84c;
  font-size:0.55rem;
  flex-shrink:0;
}

/* ─── GRID ─── */
.cir__grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:11px;
  width:100%;
}

/* ─── CARD ─── */
.cir__card{
  background:rgba(12,12,12,0.82);
  border:1px solid rgba(255,255,255,0.07);
  border-radius:20px;
  padding:26px 14px 20px;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:10px;
  text-align:center;
  -webkit-backdrop-filter:blur(18px);
  backdrop-filter:blur(18px);
  transition:
    transform .2s cubic-bezier(.34,1.56,.64,1),
    border-color .2s ease,
    background .2s ease,
    box-shadow .2s ease;
  cursor:pointer;
  opacity:0;
  transform:translateY(18px);
}
/* JS will add .cir--visible to trigger entrance */
.cir__card.cir--visible{
  opacity:1;
  transform:translateY(0);
  transition:
    opacity .45s ease,
    transform .45s cubic-bezier(.22,1,.36,1),
    border-color .2s ease,
    background .2s ease,
    box-shadow .2s ease;
}
.cir__card:hover{
  transform:translateY(-5px) scale(1.02);
  background:rgba(22,22,22,0.94);
  border-color:rgba(201,168,76,0.38);
  box-shadow:0 16px 44px rgba(0,0,0,0.55), 0 0 0 1px rgba(201,168,76,0.12);
}
.cir__card:active{
  transform:scale(0.95) translateY(0);
  transition:transform .1s ease;
}

/* ─── ICON ─── */
.cir__icon{
  width:56px;
  height:56px;
  border-radius:16px;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
  overflow:hidden;
  transition:transform .2s ease;
}
.cir__card:hover .cir__icon{
  transform:scale(1.08);
}
.cir__icon--outline{
  background:rgba(255,255,255,0.06);
  border:1px solid rgba(255,255,255,0.1);
  color:#c9a84c;
}
.cir__icon--outline svg{width:30px;height:30px}
.cir__icon--flat{
  background:transparent;
  border:none;
}
.cir__icon--flat svg{width:50px;height:50px}
.cir__icon--dark{
  background:#0c0c0c;
  border:1px solid rgba(255,255,255,0.1);
}
.cir__icon--dark svg{width:30px;height:30px}

/* ─── CARD TEXT ─── */
.cir__card-title{
  font-size:0.68rem;
  font-weight:800;
  color:#fff;
  letter-spacing:2px;
  text-transform:uppercase;
  line-height:1.2;
}
.cir__card-sub{
  font-size:0.57rem;
  color:rgba(255,255,255,0.34);
  letter-spacing:1.2px;
  text-transform:uppercase;
  line-height:1.3;
}

/* ─── FOOTER ─── */
.cir__footer{
  margin-top:52px;
  font-size:0.5rem;
  letter-spacing:3px;
  color:rgba(255,255,255,0.2);
  text-transform:uppercase;
  text-align:center;
  animation:cir-fadein 1.2s 1s ease both;
}

/* ─── STAGGER DELAYS for dividers ─── */
.cir__divider{
  opacity:0;
  animation:cir-fadeup .6s ease both;
}
.cir__divider:nth-of-type(1){animation-delay:.15s}
.cir__divider:nth-of-type(2){animation-delay:.3s}
.cir__divider:nth-of-type(3){animation-delay:.45s}

/* ─── RESPONSIVE ─── */
@media(max-width:360px){
  .cir__name{font-size:1.9rem;letter-spacing:5px}
  .cir__grid{gap:9px}
  .cir__card{padding:20px 10px 16px;border-radius:16px}
  .cir__icon{width:48px;height:48px}
  .cir__icon--flat svg{width:42px;height:42px}
}
</style>

<div class="cir">

  <!-- ── BACKGROUND ── -->
  <div class="cir__bg">
    {% if section.settings.bg_video != blank %}
      <video class="cir__bg-video" autoplay muted loop playsinline>
        <source src="{{ section.settings.bg_video }}" type="video/mp4">
      </video>
    {% elsif section.settings.bg_image != blank %}
      <img class="cir__bg-img" src="{{ section.settings.bg_image | img_url: '1400x' }}" alt="">
    {% endif %}
    <div class="cir__bg-overlay"></div>
  </div>

  <!-- ── CONTENT ── -->
  <div class="cir__body">

    <!-- BRAND -->
    <div class="cir__brand">
      {% if section.settings.logo != blank %}
        <img class="cir__logo" src="{{ section.settings.logo | img_url: '120x' }}" alt="{{ section.settings.brand_name }}">
      {% else %}
        <div class="cir__logo-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </div>
      {% endif %}
      <h1 class="cir__name">{{ section.settings.brand_name }}</h1>
    </div>

    <p class="cir__tagline">{{ section.settings.tagline }}</p>

    <!-- ── SERVICIOS ── -->
    <div class="cir__divider">{{ section.settings.label_services }}</div>
    <div class="cir__grid">

      <a class="cir__card" href="{{ section.settings.website_url }}" target="_blank" rel="noopener">
        <div class="cir__icon cir__icon--outline">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </div>
        <span class="cir__card-title">{{ section.settings.website_label }}</span>
        <span class="cir__card-sub">{{ section.settings.website_sub }}</span>
      </a>

      <a class="cir__card" href="{{ section.settings.ridenow_url }}" target="_blank" rel="noopener">
        <div class="cir__icon cir__icon--outline">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </div>
        <span class="cir__card-title">{{ section.settings.ridenow_label }}</span>
        <span class="cir__card-sub">{{ section.settings.ridenow_sub }}</span>
      </a>

    </div>

    <!-- ── APPS ── -->
    <div class="cir__divider">
      <span class="cir__divider-dot">&#9830;</span>
      {{ section.settings.label_apps }}
      <span class="cir__divider-dot">&#9830;</span>
    </div>
    <div class="cir__grid">

      <a class="cir__card" href="{{ section.settings.playstore_url }}" target="_blank" rel="noopener">
        <div class="cir__icon cir__icon--flat">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 20.5v-17c0-.83 1-.97 1.45-.32l14 8.5c.4.25.4.89 0 1.14l-14 8.5C3.97 21.47 3 21.33 3 20.5z" fill="#4CAF50"/>
            <path d="M3 3.5l8.5 8.5L3 20.5V3.5z" fill="#388E3C"/>
            <path d="M3 3.5l8.5 8.5 3-3L5.5 2.3A1.2 1.2 0 0 0 3 3.5z" fill="#81D4FA"/>
            <path d="M3 20.5l8.5-8.5 3 3-7 4.2A1.2 1.2 0 0 1 3 20.5z" fill="#F48FB1"/>
            <path d="M14.5 12l3.5-2.14-3.5-2.14L11.5 12h3z" fill="#FFF176"/>
          </svg>
        </div>
        <span class="cir__card-title">{{ section.settings.playstore_label }}</span>
        <span class="cir__card-sub">{{ section.settings.playstore_sub }}</span>
      </a>

      <a class="cir__card" href="{{ section.settings.appstore_url }}" target="_blank" rel="noopener">
        <div class="cir__icon cir__icon--dark">
          <svg viewBox="0 0 814 1000" xmlns="http://www.w3.org/2000/svg"><path fill="#fff" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76 0-103.7 40.8-165.9 40.8s-105-57.8-155.5-127.4C46 790.7 0 663 0 541.8c0-207.4 135.4-317 268.1-317 65.4 0 119.9 42.7 160.8 42.7 39 0 99.9-45 173.6-45 27.9 0 130.1 2.5 198.3 99.4zm-67.2-10.9c-17.1-20.9-48.5-37.2-77.9-37.2-35.6 0-63.8 19.3-83.9 19.3-21.4 0-53.4-18-84.2-18-59.5 0-119.7 49.4-119.7 147.3 0 89.6 35 184.3 78.6 244.9 37.4 51.5 69.6 78.8 104.2 78.8 35 0 50.9-20.5 95.7-20.5 45.5 0 57.5 20.5 96.5 20.5 38.5 0 72.4-30.1 107.4-83.2 16.2-24.2 22.3-37.4 34.8-65.1-91.4-34.7-106-162.3-5.6-206.8zm-96.7-236.7c10.1 57.3-37.1 114.5-74.7 151.5-35.7 35.1-93.3 62.2-151 62.2-5.1 0-10.2-.4-15.3-1.1-5.1-52.3 21.4-112.7 57.2-151.5 39.2-42.7 102.4-70.2 158.1-72 8.7-.2 17.3-.1 25.7 1z"/></svg>
        </div>
        <span class="cir__card-title">{{ section.settings.appstore_label }}</span>
        <span class="cir__card-sub">{{ section.settings.appstore_sub }}</span>
      </a>

    </div>

    <!-- ── CONTACTO & REDES ── -->
    <div class="cir__divider">
      <span class="cir__divider-dot">&#9830;</span>
      {{ section.settings.label_social }}
      <span class="cir__divider-dot">&#9830;</span>
    </div>
    <div class="cir__grid">

      <a class="cir__card" href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener">
        <div class="cir__icon cir__icon--flat">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="#25D366" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </div>
        <span class="cir__card-title">{{ section.settings.whatsapp_label }}</span>
        <span class="cir__card-sub">{{ section.settings.whatsapp_sub }}</span>
      </a>

      <a class="cir__card" href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener">
        <div class="cir__icon cir__icon--flat">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="#1877F2" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </div>
        <span class="cir__card-title">{{ section.settings.facebook_label }}</span>
        <span class="cir__card-sub">{{ section.settings.facebook_sub }}</span>
      </a>

      <a class="cir__card" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">
        <div class="cir__icon cir__icon--flat">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <defs><linearGradient id="cir-ig" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" style="stop-color:#f09433"/><stop offset="25%" style="stop-color:#e6683c"/><stop offset="50%" style="stop-color:#dc2743"/><stop offset="75%" style="stop-color:#cc2366"/><stop offset="100%" style="stop-color:#bc1888"/></linearGradient></defs>
            <rect width="24" height="24" rx="6" fill="url(#cir-ig)"/>
            <path fill="white" d="M12 7a5 5 0 100 10A5 5 0 0012 7zm0 8a3 3 0 110-6 3 3 0 010 6zm5.2-8.8a1.2 1.2 0 100 2.4 1.2 1.2 0 000-2.4z"/>
          </svg>
        </div>
        <span class="cir__card-title">{{ section.settings.instagram_label }}</span>
        <span class="cir__card-sub">{{ section.settings.instagram_sub }}</span>
      </a>

      <a class="cir__card" href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener">
        <div class="cir__icon cir__icon--dark">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="white" d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.75a4.85 4.85 0 01-1.01-.06z"/></svg>
        </div>
        <span class="cir__card-title">{{ section.settings.tiktok_label }}</span>
        <span class="cir__card-sub">{{ section.settings.tiktok_sub }}</span>
      </a>

    </div>

    <div class="cir__footer">&#9830; {{ section.settings.footer_copy }} &#9830;</div>

  </div>
</div>

<script>
(function(){
  /* staggered card entrance on load */
  var cards = document.querySelectorAll('.cir__card');
  var delay = 200;
  cards.forEach(function(card, i){
    setTimeout(function(){
      card.classList.add('cir--visible');
    }, delay + i * 80);
  });
})();
</script>

{% schema %}
{
  "name": "CruiseInRide",
  "tag": "div",
  "class": "cir-section-wrapper",
  "settings": [
    { "type": "header",       "content": "Marca" },
    { "type": "image_picker", "id": "logo",       "label": "Logo" },
    { "type": "text",         "id": "brand_name",  "label": "Nombre marca",   "default": "CRUISE" },
    { "type": "text",         "id": "tagline",     "label": "Tagline",        "default": "PREMIUM RIDE SERVICE" },

    { "type": "header",       "content": "Fondo" },
    { "type": "text",         "id": "bg_video",    "label": "URL video de fondo (MP4)" },
    { "type": "image_picker", "id": "bg_image",    "label": "Imagen de fondo (fallback)" },

    { "type": "header", "content": "Servicios" },
    { "type": "text", "id": "label_services",  "label": "Etiqueta servicios",  "default": "PREMIUM RIDE SERVICE" },
    { "type": "url",  "id": "website_url",     "label": "URL Website" },
    { "type": "text", "id": "website_label",   "label": "Website titulo",      "default": "WEBSITE" },
    { "type": "text", "id": "website_sub",     "label": "Website subtitulo",   "default": "Book a ride" },
    { "type": "url",  "id": "ridenow_url",     "label": "URL Ride Now" },
    { "type": "text", "id": "ridenow_label",   "label": "Ride Now titulo",     "default": "RIDE NOW" },
    { "type": "text", "id": "ridenow_sub",     "label": "Ride Now subtitulo",  "default": "VIP service" },

    { "type": "header", "content": "Apps" },
    { "type": "text", "id": "label_apps",       "label": "Etiqueta apps",          "default": "APPS" },
    { "type": "url",  "id": "playstore_url",    "label": "URL Google Play" },
    { "type": "text", "id": "playstore_label",  "label": "Google Play titulo",     "default": "GOOGLE PLAY" },
    { "type": "text", "id": "playstore_sub",    "label": "Google Play subtitulo",  "default": "Android" },
    { "type": "url",  "id": "appstore_url",     "label": "URL App Store" },
    { "type": "text", "id": "appstore_label",   "label": "App Store titulo",       "default": "APP STORE" },
    { "type": "text", "id": "appstore_sub",     "label": "App Store subtitulo",    "default": "iPhone" },

    { "type": "header", "content": "Contacto y Redes" },
    { "type": "text", "id": "label_social",     "label": "Etiqueta social",        "default": "CONTACT & SOCIAL MEDIA" },
    { "type": "url",  "id": "whatsapp_url",     "label": "URL WhatsApp" },
    { "type": "text", "id": "whatsapp_label",   "label": "WhatsApp titulo",        "default": "WHATSAPP" },
    { "type": "text", "id": "whatsapp_sub",     "label": "WhatsApp numero",        "default": "+1 (659) 305-2974" },
    { "type": "url",  "id": "facebook_url",     "label": "URL Facebook" },
