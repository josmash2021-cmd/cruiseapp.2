rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos — authenticated users can upload/read, but NEVER delete
    // Photos are PERMANENT — they survive logouts, app updates, and device changes
    match /photos/{userFolder}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create,update: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;  // ⚠️ NEVER allow deletion — photos are permanent
    }

    // Verification documents — authenticated users can upload/read
    match /documents/{userFolder}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // Liveness videos — authenticated users can upload/read
    match /videos/{userFolder}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
