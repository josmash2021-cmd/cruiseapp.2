{% comment %}
  VIP Ride Booker (Uber-like UX) - Shopify Section
  CON RESERVA POR HORAS - Hourly Booking Added
  MAPBOX GL JS — Custom dark map, animated route, tilt camera, gold pins
{% endcomment %}

{% assign bp = section.settings.booking_product %}
{% if bp %}
  {% assign booked_raw = bp.metafields.vip.booked_slots.value | default: '[]' %}
{% else %}
  {% assign booked_raw = '[]' %}
{% endif %}
<script>
  window.__VIP_BOOKED_SLOTS__     = {{ booked_raw }};
  window.__VIP_CENT_VARIANT_ID__  = 48209875435775;
  window.__VIP_VEHICLE_VARIANTS__ = {
    {% for block in section.blocks %}
      {% assign p = block.settings.product %}
      {% if p and p.variants.size > 0 %}
        "{{ block.id }}": [
          {% for v in p.variants %}
            { "id": {{ v.id }}, "price": {{ v.price }} }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]{% unless forloop.last %},{% endunless %}
      {% endif %}
    {% endfor %}
  };
</script>

<section id="vipRide-{{ section.id }}" class="vipRide">

  <div class="vipRide__bg" aria-hidden="true">
    {% if section.settings.bg_video != blank %}
      {{ section.settings.bg_video | video_tag:
        autoplay: true, loop: true, muted: true,
        controls: false, playsinline: true,
        class: 'vipRide__bgVideo'
      }}
    {% elsif section.settings.bg_video_url != blank and section.settings.bg_video_url != 'https://example.com/your-video.mp4' %}
      <video class="vipRide__bgVideo" autoplay muted loop playsinline>
        <source src="{{ section.settings.bg_video_url }}" type="video/mp4">
      </video>
    {% endif %}
    <div class="vipRide__bgOverlay"></div>
  </div>

  <div class="vipRide__wrap">

    <!-- Map -->
    <div class="vipRide__map">
      <div class="vipRide__mapInner" id="vipRideMap-{{ section.id }}"></div>
      <button type="button" class="vipRide__locateBtn" id="vipLocate-{{ section.id }}" aria-label="Use my location" title="Detect my location">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="7"/><line x1="12" y1="17" x2="12" y2="22"/><line x1="2" y1="12" x2="7" y2="12"/><line x1="17" y1="12" x2="22" y2="12"/><circle cx="12" cy="12" r="9" stroke-opacity=".3"/></svg>
      </button>
      <div class="vipRide__routePills" aria-hidden="true">
        <div class="vipRide__pill">
          <span class="vipRide__pillIcon">&#9679;</span>
          <span class="vipRide__pillText" data-vipride-pickup-pill>{{ section.settings.pickup_pill_default }}</span>
        </div>
        <div class="vipRide__pill">
          <span class="vipRide__pillIcon">&#9632;</span>
          <span class="vipRide__pillText" data-vipride-dropoff-pill>{{ section.settings.dropoff_pill_default }}</span>
        </div>
      </div>
    </div>

    <!-- Sheet -->
    <div class="vipRide__sheet" data-vipride-sheet data-vipride-step="1">
      <div class="vipRide__handle" aria-hidden="true"></div>
      <div class="vipRide__stepDots" aria-hidden="true">
        <div class="vipRide__stepDot is-active"></div>
        <div class="vipRide__stepDot"></div>
        <div class="vipRide__stepDot"></div>
      </div>

      <!-- STEP 1: Location -->
      <div class="vipRide__step" data-vipride-step-panel="1">
        <!-- Title + Lang only in step 1 -->
        <div class="vipRide__titleRow">
          <h2 class="vipRide__title">{{ section.settings.heading }}</h2>
        </div>
        <!-- Booking Mode Toggle (only in step 1) -->
        <div class="vipRide__modeToggle" data-vipride-mode-toggle>
          <button type="button" class="vipRide__modeBtn is-active" data-mode="ride" data-vipride-mode-btn>
            {{ section.settings.ride_mode_text | default: 'Point to Point' }}
          </button>
          <button type="button" class="vipRide__modeBtn" data-mode="hourly" data-vipride-mode-btn>
            {{ section.settings.hourly_mode_text | default: 'By the Hour' }}
          </button>
        </div>
        <div class="vipRide__form" data-vipride-mode="ride">

          <!-- Pickup -->
          <div class="vipRide__field">
            <label class="vipRide__label" data-vipride-pickup-label>{{ section.settings.pickup_label }}</label>
            <div class="vipRide__inputWrap">
              <span class="vipRide__inputIcon">&#9679;</span>
              <input type="text" class="vipRide__input" placeholder="{{ section.settings.pickup_placeholder }}" data-vipride-pickup autocomplete="off">
              <button type="button" class="vipRide__clear" aria-label="Clear pickup" data-vipride-clear="pickup">&times;</button>
            </div>
          </div>

          <!-- Dropoff (hidden in hourly mode) -->
          <div class="vipRide__field" data-vipride-dropoff-field>
            <label class="vipRide__label">{{ section.settings.dropoff_label }}</label>
            <div class="vipRide__inputWrap">
              <span class="vipRide__inputIcon">&#9632;</span>
              <input type="text" class="vipRide__input" placeholder="{{ section.settings.dropoff_placeholder }}" data-vipride-dropoff autocomplete="off">
              <button type="button" class="vipRide__clear" aria-label="Clear dropoff" data-vipride-clear="dropoff">&times;</button>
            </div>
          </div>

          <!-- Hours Selector (visible only in hourly mode) -->
          <div class="vipRide__field vipRide__field--hours" data-vipride-hours-field hidden>
            <label class="vipRide__label">{{ section.settings.hours_label | default: 'Duration' }}</label>
            <div class="vipRide__hoursWrap">
              <button type="button" class="vipRide__hoursBtn" data-vipride-hours-minus aria-label="Decrease hours">&#8722;</button>
              <div class="vipRide__hoursDisplay">
                <span class="vipRide__hoursValue" data-vipride-hours-value>4</span>
                <span class="vipRide__hoursUnit">{{ section.settings.hours_unit | default: 'hours' }}</span>
              </div>
              <button type="button" class="vipRide__hoursBtn" data-vipride-hours-plus aria-label="Increase hours">&#43;</button>
            </div>
            <input type="hidden" data-vipride-hours-input value="4">
            <div class="vipRide__hoursHint" data-vipride-hours-hint>
              {{ section.settings.hours_hint | default: 'Minimum 3 hours, maximum 12 hours' }}
            </div>
          </div>

          <!-- Step 1 CTA -->
          <button type="button" class="vipRide__stepNext" data-vipride-step1-next disabled>
            {{ section.settings.see_prices_text | default: 'Continue' }} &#8250;
          </button>
        </div>
      </div>

      <!-- STEP 2: Date & Time -->
      <div class="vipRide__step" data-vipride-step-panel="2" hidden>
        <!-- Step back -->
        <button type="button" class="vipRide__stepBack" data-vipride-step-back>&#8592; <span data-vipride-stepback-label></span></button>

        <div class="vipRide__form">
          <!-- Date -->
          <div class="vipRide__field">
            <label class="vipRide__label" for="vipDate-{{ section.id }}">{{ section.settings.date_label }}</label>
            <div class="vipRide__inputWrap vipRide__inputWrap--date" id="vipDateWrap-{{ section.id }}">
              <span class="vipRide__inputIcon">&#128197;</span>
              <input
                type="date"
                id="vipDate-{{ section.id }}"
                class="vipRide__input vipRide__input--dt vipRide__input--date"
                data-vipride-date
                autocomplete="off"
              >
            </div>
          </div>

          <!-- Time -->
          <div class="vipRide__field vipRide__field--time" data-vipride-time-field>
            <label class="vipRide__label">{{ section.settings.time_label }}</label>

            <button
              type="button"
              class="vipRide__timeTrigger"
              data-vipride-time-trigger
              aria-expanded="false"
              aria-controls="vipTimeAccordion-{{ section.id }}"
            >
              <span class="vipRide__timeTrigger__text" data-vipride-slot-display></span>
              <span class="vipRide__timeTrigger__arrow" aria-hidden="true">&#9662;</span>
            </button>

            <input type="time" class="vipRide__input vipRide__input--dt" data-vipride-time style="display:none">

            <div
              class="vipRide__timeAccordion"
              id="vipTimeAccordion-{{ section.id }}"
              data-vipride-slotpicker
              hidden
            >
              <div class="vipRide__timeAccordion__inner">
                <p class="vipRide__slotHint" data-vipride-slot-hint></p>
              </div>
            </div>
          </div>

          <!-- Step 2: auto-advance when date+time filled, no button needed -->
        </div>
      </div>

      <!-- STEP 3: Vehicle -->
      <div class="vipRide__step" data-vipride-step-panel="3" hidden>
        <!-- Step back -->
        <button type="button" class="vipRide__stepBack" data-vipride-step-back2>&#8592; <span data-vipride-stepback2-label></span></button>

        <div class="vipRide__prices" data-vipride-prices>
          <div class="vipRide__pricesHeader">
            <span class="vipRide__pricesTitle" data-vipride-prices-title>{{ section.settings.choose_ride_text }}</span>
          </div>

          <div class="vipRide__routeEstimate" data-vipride-route-estimate hidden>
            <span class="vipRide__routeEstimateLabel">&#128337; </span>
            <span data-vipride-route-time>--</span>
          </div>

          <div class="vipRide__rideList" role="list">
            {% for block in section.blocks %}
              {% assign p = block.settings.product %}
              {% assign v = nil %}
              {% if p and p.variants.size > 0 %}
                {% assign v = p.selected_or_first_available_variant %}
              {% endif %}
              <button
                type="button"
                class="vipRide__rideCard{% if block.settings.disabled %} vipRide__rideCard--disabled{% endif %}"
                role="listitem"
                data-vipride-card
                data-title="{{ block.settings.title | escape }}"
                data-seats="{{ block.settings.seats }}"
                data-desc="{{ block.settings.desc | escape }}"
                data-price="{% if v %}{{ v.price | money }}{% else %}{{ block.settings.manual_price | escape }}{% endif %}"
                data-rate="{{ block.settings.vehicle_rate }}"
                data-variant-id="{% if v %}{{ v.id }}{% endif %}"
                data-block-id="{{ block.id }}"
                data-hourly-price="{{ block.settings.hourly_rate | default: block.settings.vehicle_rate }}"
                {% if block.settings.disabled %}disabled data-disabled="true"{% endif %}
              >
                <div class="vipRide__rideImg">
                  {% if block.settings.image %}
                    {{ block.settings.image | image_url: width: 220 | image_tag: loading: 'lazy', class: 'vipRide__rideImgTag', alt: block.settings.title }}
                  {% else %}
                    <div class="vipRide__rideImgPh">&#128664;</div>
                  {% endif %}
                </div>
                <div class="vipRide__rideMeta">
                  <div class="vipRide__rideTop">
                    <div class="vipRide__rideName">{{ block.settings.title }}</div>
                    <div class="vipRide__ridePrice" data-vipride-card-price>
                      {% if v %}{{ v.price | money }}{% else %}{{ block.settings.manual_price }}{% endif %}
                    </div>
                    <div class="vipRide__rideEta" data-vipride-eta>--</div>
                  </div>
                  <div class="vipRide__rideSub">
                    <span class="vipRide__seats">
                      <span class="vipRide__personIcon">&#128100;</span>
                      {{ block.settings.seats }}
                    </span>
                    {% if block.settings.badge != blank %}
                      <span class="vipRide__badge">{{ block.settings.badge }}</span>
                    {% endif %}
                  </div>
                  {% if block.settings.desc != blank %}
                    <div class="vipRide__rideDesc">{{ block.settings.desc }}</div>
                  {% endif %}
                </div>
              </button>
            {% endfor %}
          </div>

          <form class="vipRide__ctaForm" data-vipride-form>
            <input type="hidden" name="id"       value="" data-vipride-booking-variant>
            <input type="hidden" name="quantity" value="1" data-vipride-quantity>
            <input type="hidden" name="properties[Booking Type]"  value="ride" data-vipride-prop="bookingType">
            <input type="hidden" name="properties[Pickup]"          value="" data-vipride-prop="pickup">
            <input type="hidden" name="properties[Dropoff]"         value="" data-vipride-prop="dropoff">
            <input type="hidden" name="properties[Hours]"           value="" data-vipride-prop="hours">
            <input type="hidden" name="properties[Date]"            value="" data-vipride-prop="date">
            <input type="hidden" name="properties[Time]"            value="" data-vipride-prop="time">
            <input type="hidden" name="properties[Vehicle]"         value="" data-vipride-prop="vehicle">
            <input type="hidden" name="properties[Estimated Price]" value="" data-vipride-prop="price">
            <button type="submit" class="vipRide__cta" data-vipride-cta disabled>
              {{ section.settings.cta_default_text }}
            </button>
            <button type="button" class="vipRide__checkout" data-vipride-checkout disabled>
              Checkout
            </button>
            <div class="vipRide__hint" data-vipride-hint>{{ section.settings.cta_hint_text }}</div>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Set browser theme-color to black to match the dark page
  (function(){
    var existing = document.querySelector('meta[name="theme-color"]');
    if(existing){ existing.setAttribute('content','#000000'); }
    else{
      var m = document.createElement('meta');
      m.name = 'theme-color'; m.content = '#000000';
      document.head.appendChild(m);
    }
    var ab = document.querySelector('meta[name="apple-mobile-web-app-status-bar-style"]');
    if(!ab){
      var a = document.createElement('meta');
      a.name = 'apple-mobile-web-app-status-bar-style'; a.content = 'black-translucent';
      document.head.appendChild(a);
    }
  })();
</script>

<!-- Mapbox GL JS -->
<link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js"></script>

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700;800;900&display=swap" rel="stylesheet">

<style>
/* Dark browser chrome: body + html background black when this section is present */
body:has(#vipRide-{{ section.id }}),
html:has(#vipRide-{{ section.id }}){
  background:#000 !important;
  background-color:#000 !important;
}
body:has(#vipRide-{{ section.id }}){
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
body:has(#vipRide-{{ section.id }}) footer,
body:has(#vipRide-{{ section.id }}) .footer,
body:has(#vipRide-{{ section.id }}) #footer,
body:has(#vipRide-{{ section.id }}) [class*="footer"],
body:has(#vipRide-{{ section.id }}) [id*="footer"]{ display:none !important; }

#vipRide-{{ section.id }}{
  --vip-gold:        #D4AF37;
  --vip-gold-2:      #FFD700;
  --vip-glass:       rgba(0,0,0,.55);
  --vip-border:      rgba(255,255,255,.16);
  --vip-ease:        cubic-bezier(.2,.8,.2,1);
  --vip-hover-speed: 260ms;
}
.vipRide{
  position:relative; overflow:hidden;
  background:#000; color:#fff;
  isolation:isolate;
  height:100vh; min-height:600px;
}
@media (max-width:899px){
  .vipRide{ height:100svh; min-height:100svh; padding-top:0; overflow:hidden; }
  .vipRide.js-height-locked{ height:var(--vip-locked-h,100svh) !important; min-height:var(--vip-locked-h,100svh) !important; }
}
.vipRide,.vipRide *{
  box-sizing:border-box;
  text-shadow:none !important;
  -webkit-text-stroke:0 !important;
  filter:none !important;
  -webkit-tap-highlight-color:transparent;
}
.vipRide__step,.vipRide__step *{ filter:none !important; }
.vipRide__bg{ position:absolute; inset:0; z-index:0; overflow:hidden; pointer-events:none; }
.vipRide__bg::before{
  content:""; position:absolute; inset:0; z-index:2; pointer-events:none;
  background:linear-gradient(to bottom,rgba(0,0,0,.85) 0%,rgba(0,0,0,.45) 25%,rgba(0,0,0,0) 55%);
}
.vipRide__bgVideo{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transform:scale(1.02); }
.vipRide__bgOverlay{ position:absolute; inset:0; background:rgba(0,0,0,.30); }
.vipRide__wrap{
  position:relative; z-index:1;
  display:flex; flex-direction:row; align-items:flex-start;
  max-width:1280px; margin:0 auto;
  padding:28px 36px; gap:28px;
  height:100%;
}
/* Desktop: map fills full wrap, sheet floats on top */
@media (min-width:900px){
  .vipRide__map{
    position:absolute !important;
    inset:0 !important;
    height:100% !important; width:100% !important;
    border-radius:0; min-height:0;
  }
  .vipRide__sheet{
    position:absolute !important;
    top:var(--vip-top-offset, 120px) !important;
    right:36px !important;
    left:auto !important; bottom:auto !important;
    width:300px !important;
    height:auto !important; max-height:calc(100vh - var(--vip-top-offset, 120px) - 60px) !important;
    overflow-y:auto !important;
    z-index:10;
    margin:0 !important;
  }
  .vipRide__handle{ display:none; }
}
@media (min-width:600px) and (max-width:899px){
  .vipRide__sheet{ max-height:72vh; }
}
@media (max-width:899px){
  .vipRide__wrap{ position:absolute; inset:0; padding:0; display:flex; flex-direction:column; }
}
.vipRide__map{
  position:relative; flex:1;
  border-radius:18px; overflow:hidden;
  background:rgba(0,0,0,.35);
  border:1px solid rgba(255,255,255,.16);
  touch-action:auto;
  min-height:320px;
}
@media (max-width:899px){
  .vipRide__map{ position:absolute; inset:0; height:100% !important; min-height:0 !important; border-radius:0; border:none; }
}
.vipRide__mapInner{ height:100%; width:100%; }
#vipRideMap-{{ section.id }},
#vipRideMap-{{ section.id }} > div{ height:100% !important; width:100% !important; border-radius:inherit; }

/* Mapbox attribution — keep compact */
#vipRideMap-{{ section.id }} .mapboxgl-ctrl-attrib{ font-size:9px; opacity:.35; }
#vipRideMap-{{ section.id }} .mapboxgl-ctrl-logo{ opacity:.35; }
#vipRideMap-{{ section.id }} .mapboxgl-canvas{ border-radius:inherit; }
/* Mapbox zoom controls — dark theme */
#vipRideMap-{{ section.id }} .mapboxgl-ctrl-group{ background:rgba(0,0,0,.65); border:1px solid rgba(255,255,255,.15); border-radius:12px; overflow:hidden; box-shadow:0 4px 16px rgba(0,0,0,.4); }
#vipRideMap-{{ section.id }} .mapboxgl-ctrl-group button{ width:36px; height:36px; background:transparent; border:none; color:#fff; }
#vipRideMap-{{ section.id }} .mapboxgl-ctrl-group button:hover{ background:rgba(255,255,255,.1); }
#vipRideMap-{{ section.id }} .mapboxgl-ctrl-group button+button{ border-top:1px solid rgba(255,255,255,.1); }
#vipRideMap-{{ section.id }} .mapboxgl-ctrl-group button .mapboxgl-ctrl-icon{ filter:invert(1); }

.vipRide__back{
  position:absolute; top:14px; left:14px;
  background:rgba(0,0,0,.55); border:1px solid rgba(255,255,255,.18);
  border-radius:999px; padding:10px 12px;
  cursor:pointer; color:#fff; z-index:3;
}
#vipRide-{{ section.id }} .vipRide__routePills{ display:none !important; }
.vipRide__locateBtn{
  position:absolute; bottom:14px; right:14px; z-index:3;
  background:rgba(0,0,0,.65); border:1px solid rgba(255,255,255,.2);
  border-radius:12px; width:46px; height:46px;
  display:flex; align-items:center; justify-content:center;
  cursor:pointer; color:var(--vip-gold); padding:0;
  transition:background 200ms, border-color 200ms;
}
.vipRide__locateBtn:hover{ background:rgba(212,175,55,.15); border-color:rgba(212,175,55,.5); }
.vipRide__locateBtn.is-locating{ animation:vipLocatePulse 1s ease-in-out infinite; border-color:var(--vip-gold); }
@keyframes vipLocatePulse{ 0%,100%{ box-shadow:0 0 0 0 rgba(212,175,55,.5); } 70%{ box-shadow:0 0 0 10px rgba(212,175,55,0); } }

/* ══ Mapbox Custom Markers ══ */
.vipRide__marker{ cursor:pointer; }
.vipRide__markerInner{
  display:block; width:50px; height:65px;
  will-change:transform,opacity;
  animation:vipMarkerPop 1200ms cubic-bezier(.22,.61,.36,1) forwards;
  filter:drop-shadow(0 3px 6px rgba(212,168,0,.45));
  position:relative;
}
.vipRide__markerInner svg{ display:block; width:50px; height:65px; }
@keyframes vipMarkerPop{
  0%  { transform:scale(0) translateY(30px); opacity:0; }
  35% { transform:scale(1.06) translateY(-2px); opacity:1; }
  55% { transform:scale(0.98) translateY(1px); opacity:1; }
  75% { transform:scale(1.02) translateY(0); opacity:1; }
  100%{ transform:scale(1) translateY(0); opacity:1; }
}
.vipRide__markerInner::after{
  content:''; position:absolute; bottom:-4px; left:50%; transform:translateX(-50%);
  width:14px; height:6px; border-radius:50%;
  background:rgba(212,175,55,.35);
  animation:vipPinShadow 4s ease-in-out infinite;
}
@keyframes vipPinShadow{
  0%,100%{ transform:translateX(-50%) scale(1); opacity:.35; }
  50%{ transform:translateX(-50%) scale(1.6); opacity:.12; }
}

/* ══ Autocomplete Suggestions ══ */
.vipRide__suggestions{
  position:absolute; top:100%; left:0; right:0; z-index:99999;
  background:rgba(10,8,4,.92);
  backdrop-filter:blur(24px) saturate(1.3);
  -webkit-backdrop-filter:blur(24px) saturate(1.3);
  border:1px solid rgba(212,175,55,.22);
  border-radius:14px; margin-top:4px;
  overflow:hidden;
  box-shadow:0 12px 40px rgba(0,0,0,.55);
  display:none;
  max-height:260px; overflow-y:auto;
  -webkit-overflow-scrolling:touch;
}
.vipRide__suggestion{
  padding:12px 14px; color:#fff; font-size:14px; cursor:pointer;
  border-top:1px solid rgba(255,255,255,.08);
  transition:background 180ms;
  display:flex; align-items:flex-start; gap:10px;
}
.vipRide__suggestion:first-child{ border-top:none; }
.vipRide__suggestion:hover,
.vipRide__suggestion.is-active{ background:rgba(212,175,55,.14); }
.vipRide__suggestionIcon{
  flex-shrink:0; width:18px; height:18px; margin-top:2px; opacity:.5;
  color:var(--vip-gold);
}
.vipRide__suggestionText{ flex:1; min-width:0; }
.vipRide__suggestionMain{ font-weight:700; font-size:14px; color:#fff; }
.vipRide__suggestionSub{ font-size:12px; color:rgba(255,255,255,.5); margin-top:1px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

/* ══ Booking Mode Toggle ══ */
.vipRide__modeToggle{
  display:flex; gap:4px; margin:0 0 10px;
  background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.08);
  border-radius:12px; padding:3px;
}
.vipRide__modeBtn{
  flex:1; padding:8px 10px; border-radius:10px;
  background:transparent; border:none; color:rgba(255,255,255,.65);
  font-size:12px; font-weight:700; letter-spacing:.04em; cursor:pointer;
  transition:all 200ms var(--vip-ease);
  white-space:nowrap;
}
.vipRide__modeBtn:hover{ color:var(--vip-gold); }
.vipRide__modeBtn.is-active{
  background:var(--vip-gold); color:#000 !important;
  font-weight:800;
  box-shadow:0 4px 14px rgba(212,175,55,.3);
}

/* ══ Language Toggle ══ */
.vipRide__titleRow{ display:flex; align-items:center; justify-content:space-between; gap:12px; }
.vipRide__langToggle{
  display:flex; gap:4px;
  background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.12);
  border-radius:10px; padding:3px;
}
.vipRide__langBtn{
  padding:6px 10px; border-radius:8px;
  background:transparent; border:none; color:#fff;
  font-size:12px; font-weight:600; cursor:pointer;
  transition:all 200ms ease;
}
.vipRide__langBtn:hover{ color:var(--vip-gold); }
.vipRide__langBtn.is-active{
  background:var(--vip-gold); color:#000 !important;
  font-weight:700;
}

.vipRide__sheet{
  position:relative; margin-top:0;
  background:#1A1A1A;
  border-radius:20px;
  border:none;
  box-shadow:0 -4px 24px rgba(0,0,0,.5);
  padding:12px 14px 16px;
  backdrop-filter:none;
  -webkit-backdrop-filter:none;
  overflow-y:auto;
  -webkit-overflow-scrolling:touch;
  align-self:flex-start;
}
@media (max-width:899px){
  .vipRide__sheet{
    position:absolute; bottom:16px; left:16px; right:16px; z-index:10;
    margin-top:0;
    max-height:62vh;
    overflow-y:auto;
    -webkit-overflow-scrolling:touch;
    border-radius:20px;
  }
}
.vipRide__handle{ width:36px; height:4px; border-radius:2px; background:rgba(255,255,255,.15); margin:0 auto 10px; }
.vipRide__title{ margin:0; font-family:'Poppins',Inter,system-ui,sans-serif; font-size:18px; font-weight:800; letter-spacing:-.03em; text-transform:none; color:rgba(255,255,255,.9) !important; }
.vipRide__form{ margin-top:10px; display:flex; flex-direction:column; gap:8px; }
.vipRide__field{ display:flex; flex-direction:column; gap:6px; position:relative; }
.vipRide__field:focus-within{ z-index:99999; }
.vipRide__field--hours{ margin-bottom:4px; }
.vipRide__field--hours[hidden]{ display:none !important; }
.vipRide__label{ font-size:9px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:rgba(212,175,55,.7) !important; }
.vipRide__inputWrap{
  display:flex; align-items:center; gap:8px;
  background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.10);
  border-radius:12px; padding:10px 12px; position:relative; box-shadow:none !important;
  transition:border-color 200ms ease, background 200ms ease;
}
.vipRide__inputWrap:focus-within{
  border-color:rgba(212,175,55,.55) !important;
  background:rgba(212,175,55,.06) !important;
}
.vipRide__inputIcon{ opacity:.95; color:#fff; user-select:none; flex-shrink:0; }
.vipRide__input{
  width:100%; border:0; outline:none;
  background:transparent !important; background-color:transparent !important;
  font-size:16px; color:#fff !important;
  box-shadow:none !important; -webkit-appearance:none; appearance:none;
}
.vipRide__input::placeholder{ color:rgba(255,255,255,.55) !important; }
.vipRide__input:focus{ box-shadow:none !important; outline:none !important; font-size:16px !important; }
.vipRide__input--dt{ color-scheme:dark; }
.vipRide__input--dt::-webkit-datetime-edit,
.vipRide__input--dt::-webkit-datetime-edit-text,
.vipRide__input--dt::-webkit-datetime-edit-month-field,
.vipRide__input--dt::-webkit-datetime-edit-day-field,
.vipRide__input--dt::-webkit-datetime-edit-year-field,
.vipRide__input--dt::-webkit-datetime-edit-hour-field,
.vipRide__input--dt::-webkit-datetime-edit-minute-field{ color:#fff; }
.vipRide__inputWrap--date{ cursor:pointer; position:relative; }
.vipRide__input--date{ cursor:pointer; flex:1; }
.vipRide__input--date::-webkit-calendar-picker-indicator{
  opacity:0; cursor:pointer;
  position:absolute; inset:0; width:100%; height:100%;
}
.vipRide input[type="time"]::-webkit-calendar-picker-indicator{ display:none !important; opacity:0 !important; }
.vipRide input[type="time"]{ background:transparent !important; color:#fff !important; -webkit-appearance:none !important; appearance:none !important; }

/* ══ Hours Selector ══ */
.vipRide__hoursWrap{
  display:flex; align-items:center; justify-content:center; gap:16px;
  background:rgba(255,255,255,.10); border:1px solid rgba(255,255,255,.18);
  border-radius:12px; padding:12px 16px;
}
.vipRide__hoursBtn{
  width:40px; height:40px; border-radius:10px;
  background:var(--vip-gold); border:none; color:#000;
  font-size:20px; font-weight:700; cursor:pointer;
  display:flex; align-items:center; justify-content:center;
  transition:transform 150ms, opacity 200ms;
  touch-action:manipulation;
}
.vipRide__hoursBtn:hover:not(:disabled){ transform:scale(1.1); }
.vipRide__hoursBtn:active:not(:disabled){ transform:scale(0.95); }
.vipRide__hoursBtn:disabled{ opacity:0.35; cursor:not-allowed; }
.vipRide__hoursDisplay{
  display:flex; align-items:baseline; gap:6px;
  min-width:80px; justify-content:center;
}
.vipRide__hoursValue{
  font-size:28px; font-weight:700; color:var(--vip-gold);
  min-width:30px; text-align:center;
}
.vipRide__hoursUnit{
  font-size:14px; color:rgba(255,255,255,.7);
}
.vipRide__hoursHint{
  font-size:11px; color:rgba(255,255,255,.5);
  text-align:center; margin-top:4px;
}

.vipRide__clear{
  position:absolute; right:10px; top:50%; transform:translateY(-50%);
  border:1px solid rgba(255,255,255,.18); background:rgba(0,0,0,.25);
  width:28px; height:28px; border-radius:999px;
  cursor:pointer; font-size:18px; line-height:26px; display:none; color:#fff;
}
.vipRide__timeTrigger{
  display:flex; align-items:center; gap:8px; width:100%;
  background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.12);
  border-radius:12px; padding:10px 12px; cursor:pointer; color:#fff;
  text-align:left; transition:border-color 200ms, background 200ms;
}
.vipRide__timeTrigger:hover,
.vipRide__timeTrigger[aria-expanded="true"]{ border-color:var(--vip-gold); background:rgba(212,175,55,.08); }
.vipRide__timeTrigger[aria-expanded="true"]{ border-bottom-left-radius:0; border-bottom-right-radius:0; border-bottom-color:transparent; }
.vipRide__timeTrigger__text{ flex:1; font-size:13px; color:rgba(255,255,255,.65); transition:color 200ms; }
.vipRide__timeTrigger__text.has-value{ color:#fff; font-weight:600; }
.vipRide__timeTrigger__arrow{ font-size:14px; color:var(--vip-gold); transition:transform 300ms var(--vip-ease); flex-shrink:0; }
.vipRide__timeTrigger[aria-expanded="true"] .vipRide__timeTrigger__arrow{ transform:rotate(180deg); }
.vipRide__timeAccordion{
  overflow:hidden; max-height:0;
  transition:max-height 400ms var(--vip-ease), opacity 300ms ease;
  opacity:0;
  border:1px solid var(--vip-gold); border-top:none;
  border-bottom-left-radius:14px; border-bottom-right-radius:14px;
  background:rgba(10,8,4,.92); backdrop-filter:blur(16px);
}
.vipRide__timeAccordion:not([hidden]).is-open{ max-height:52vh; opacity:1; }
.vipRide__timeAccordion:not([hidden]){ display:block !important; }
.vipRide__timeAccordion__inner{
  padding:14px 12px 16px; overflow-y:auto; max-height:48vh;
  -webkit-overflow-scrolling:touch;
  touch-action:pan-y;
  scrollbar-width:thin; scrollbar-color:rgba(212,175,55,.3) transparent;
}
.vipRide__timeAccordion__inner::-webkit-scrollbar{ width:4px; }
.vipRide__timeAccordion__inner::-webkit-scrollbar-track{ background:transparent; }
.vipRide__timeAccordion__inner::-webkit-scrollbar-thumb{ background:rgba(212,175,55,.35); border-radius:4px; }
.vipRide__slotSection{ margin-bottom:10px; }
.vipRide__slotSection:last-child{ margin-bottom:0; }
.vipRide__slotSectionTitle{
  font-size:10px; font-weight:700; letter-spacing:.14em;
  text-transform:uppercase; color:rgba(212,175,55,.65); margin:0 0 6px 2px;
}
.vipRide__slotGrid{ display:grid; grid-template-columns:repeat(4,1fr); gap:6px; }
.vipRide__slot{
  padding:10px 4px; border-radius:10px;
  border:1px solid rgba(212,175,55,.30); background:rgba(255,255,255,.05);
  color:var(--vip-gold); font-size:13px; font-weight:600; cursor:pointer;
  transition:background 180ms, border-color 180ms, transform 140ms;
  text-align:center; white-space:nowrap; line-height:1;
  touch-action:manipulation;
}
.vipRide__slot:hover:not(:disabled){ background:rgba(212,175,55,.18); border-color:var(--vip-gold); transform:scale(1.05); }
.vipRide__slot:active:not(:disabled){ transform:scale(.95); }
.vipRide__slot--active{ background:var(--vip-gold) !important; color:#000 !important; border-color:var(--vip-gold) !important; font-weight:900; box-shadow:0 0 14px rgba(212,175,55,.45); }
.vipRide__slot--blocked{ background:rgba(255,255,255,.02) !important; border-color:rgba(255,255,255,.06) !important; color:rgba(255,255,255,.18) !important; cursor:not-allowed !important; text-decoration:line-through; pointer-events:none; }
.vipRide__slotHint{ font-size:12px; color:rgba(255,255,255,.4); margin:0; text-align:center; padding:8px 0; }
.vipRide__seePrices{
  margin-top:4px;
  background:var(--vip-gold) !important;
  color:#000 !important;
  border:none !important;
  border-radius:12px;
  padding:13px 16px;
  font-size:13px; font-weight:800; letter-spacing:.08em; text-transform:uppercase;
  cursor:pointer;
  box-shadow:0 6px 20px rgba(212,175,55,.3), 0 2px 6px rgba(0,0,0,.35);
  transition:opacity 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  touch-action:manipulation;
  width:100%;
}
.vipRide__seePrices[disabled]{
  background:rgba(212,175,55,.2) !important;
  color:rgba(255,255,255,.35) !important;
  box-shadow:none;
  cursor:not-allowed; pointer-events:none;
}
.vipRide__seePrices:not([disabled]):hover{ opacity:.9; transform:translateY(-1px); box-shadow:0 12px 40px rgba(212,175,55,.45); }
.vipRide__prices{ margin-top:4px; }
.vipRide__pricesHeader{ display:flex; align-items:center; justify-content:space-between; margin-bottom:6px; }
.vipRide__pricesTitle{ font-family:'Poppins',Inter,system-ui,sans-serif; font-size:18px; font-weight:800; color:rgba(255,255,255,.9) !important; text-transform:none; letter-spacing:-.03em; }
.vipRide__routeEstimate{ margin:6px 0 10px; padding:8px 12px; border-radius:12px; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.08); display:flex; gap:6px; align-items:center; font-size:12px; color:rgba(255,255,255,.65); }
.vipRide__routeEstimateLabel{ opacity:.7; }
.vipRide__rideList{ display:flex; flex-direction:column; gap:8px; }
.vipRide__rideCard{
  display:grid !important; grid-template-columns:100px 1fr;
  align-items:center; gap:10px;
  width:100% !important; max-width:100% !important; overflow:hidden;
  min-height:80px; padding:12px 14px !important;
  border:1px solid rgba(255,255,255,.06); border-radius:16px;
  background:#1E1E1E !important; cursor:pointer; text-align:left; color:#fff;
  box-shadow:0 4px 8px rgba(0,0,0,.15) !important;
  transition:transform var(--vip-hover-speed) var(--vip-ease),
    box-shadow var(--vip-hover-speed) var(--vip-ease),
    border-color var(--vip-hover-speed) var(--vip-ease),
    background var(--vip-hover-speed) var(--vip-ease);
  will-change:transform; transform:translateZ(0);
  touch-action:manipulation;
  position:relative;
}
.vipRide__rideCard *{ color:#fff; text-shadow:none !important; }
@media (hover:hover) and (pointer:fine){
  .vipRide__rideCard:hover{ transform:translateY(-3px) scale(1.01); border-color:rgba(255,255,255,.15); box-shadow:0 12px 32px rgba(0,0,0,.35) !important; }
  .vipRide__rideCard:hover .vipRide__rideImgTag{ transform:scale(1.04); }
}
.vipRide__rideCard:active{ transform:scale(.98); }
@keyframes vipSelectPop{ 0%{ transform:scale(.95); } 60%{ transform:scale(1.05); } 100%{ transform:translateY(-4px) scale(1.025); } }
.vipRide__rideCard.is-active{ animation:vipSelectPop 400ms var(--vip-ease) forwards; border-color:#E8C547; border-width:1.5px; background:linear-gradient(135deg,#1A1708 0%,#1E1E1E 100%) !important; box-shadow:0 12px 48px rgba(0,0,0,.35), 0 0 0 .5px rgba(232,197,71,.3), 0 0 20px rgba(232,197,71,.08) !important; }
.vipRide__rideCard.is-active::after{ content:'\2713'; position:absolute; top:12px; right:12px; width:24px; height:24px; border-radius:50%; background:#E8C547; color:#000; font-size:14px; font-weight:800; display:flex; align-items:center; justify-content:center; line-height:1; animation:vipCheckPop 350ms cubic-bezier(.2,.8,.2,1) both; }
@keyframes vipCheckPop{ 0%{ transform:scale(0); opacity:0; } 60%{ transform:scale(1.2); } 100%{ transform:scale(1); opacity:1; } }
.vipRide__rideCard--disabled{ opacity:.35 !important; pointer-events:none !important; cursor:not-allowed !important; filter:grayscale(.8) !important; position:relative; }
.vipRide__rideCard--disabled::after{ content:'COMING SOON'; position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:rgba(0,0,0,.7); color:var(--vip-gold); font-size:11px; font-weight:800; letter-spacing:.12em; padding:6px 14px; border-radius:8px; border:1px solid rgba(212,175,55,.4); text-transform:uppercase; pointer-events:none; z-index:2; }
.vipRide__rideImg{ width:100%; overflow:hidden; }
.vipRide__rideImgTag,.vipRide__rideCard img{ display:block; width:100% !important; max-width:100% !important; height:auto !important; object-fit:contain !important; transition:transform 260ms var(--vip-ease); }
.vipRide__rideImgPh{ background:transparent; border:none; }
.vipRide__rideMeta{ min-width:0; }
.vipRide__rideTop{ display:flex; flex-wrap:wrap; align-items:baseline; gap:4px 8px; box-sizing:border-box; }
.vipRide__rideName{ font-size:14px; font-weight:700; flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:rgba(255,255,255,.9); }
.vipRide__ridePrice{ white-space:nowrap; font-weight:900; font-size:14px; margin-left:auto; color:#E8C547 !important; }
.vipRide__rideEta{ font-size:11px; font-weight:600; white-space:nowrap; margin-top:2px; background:rgba(255,255,255,.06); padding:3px 8px; border-radius:6px; color:rgba(255,255,255,.50) !important; display:inline-block; }
.vipRide__rideSub{ margin-top:6px; display:flex; flex-wrap:wrap; gap:6px; align-items:center; }
.vipRide__seats{ background:rgba(255,255,255,.06); padding:3px 8px; border-radius:6px; font-size:11px; font-weight:600; color:rgba(255,255,255,.50) !important; display:inline-flex; align-items:center; gap:3px; }
.vipRide__personIcon{ color:rgba(255,255,255,.50) !important; text-shadow:none !important; font-size:11px; }
.vipRide__badge{ padding:3px 10px; border-radius:8px; font-size:10px; font-weight:800; letter-spacing:1.2px; text-transform:uppercase; position:relative; overflow:hidden; }
.vipRide__badge--vip,.vipRide__badge:not([class*='--']){ background:linear-gradient(135deg,#E8C547,#D4A574); color:#000; border:none; }
.vipRide__badge--premium{ background:linear-gradient(135deg,#E8E8E8,#B0B0B0); color:#000; border:none; }
.vipRide__badge--comfort{ background:linear-gradient(135deg,#66BB6A,#388E3C); color:#fff; border:none; }
/* Badge shimmer */
.vipRide__badge::before{ content:''; position:absolute; top:0; left:-100%; width:60%; height:100%; background:linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent); animation:vipBadgeShimmer 1800ms ease-in-out infinite; }
@keyframes vipBadgeShimmer{ 0%{ left:-100%; } 100%{ left:200%; } }
.vipRide__rideDesc{ font-size:10px; color:#E8C547; opacity:.8; margin-top:2px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; letter-spacing:.02em; }
.vipRide__ctaForm{ margin-top:14px; margin-bottom:0; }
.vipRide__ctaForm[hidden]{ display:none !important; }
.vipRide__cta{ width:100%; height:52px; background:linear-gradient(to bottom,#E8C547,#D4A520) !important; color:#000 !important; border:none !important; border-radius:14px; padding:0 16px; font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif !important; font-size:17px; font-weight:800; letter-spacing:-.03em; text-transform:none; cursor:pointer; box-shadow:0 4px 12px rgba(212,165,32,.35) !important; transition:opacity 200ms ease, transform 200ms ease, box-shadow 200ms ease; touch-action:manipulation; }
.vipRide__cta[disabled]{ opacity:.35 !important; background:linear-gradient(to bottom,#E8C547,#D4A520) !important; color:#000 !important; cursor:not-allowed !important; transform:none !important; box-shadow:none !important; }
.vipRide__cta:not([disabled]):hover{ transform:translateY(-2px); box-shadow:0 8px 24px rgba(212,165,32,.45) !important; }
.vipRide__hint{ margin-top:8px; font-size:12px; color:rgba(255,255,255,.75); }
.vipRide__checkout{
  width:100%; margin-top:8px;
  background:rgba(255,255,255,.06) !important; color:rgba(255,255,255,.75) !important;
  border:1px solid rgba(255,255,255,.10) !important; border-radius:14px;
  padding:14px 16px; height:50px;
  font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif !important;
  font-size:15px; font-weight:600; letter-spacing:0; text-transform:none;
  cursor:pointer; box-shadow:none !important;
  transition:opacity 200ms ease, transform 200ms ease, background 200ms ease;
  touch-action:manipulation;
}
.vipRide__checkout[disabled]{
  opacity:.35 !important; background:rgba(255,255,255,.04) !important;
  color:rgba(255,255,255,.35) !important; border-color:rgba(255,255,255,.06) !important;
  cursor:not-allowed !important; transform:none !important; box-shadow:none !important;
}
.vipRide__checkout:not([disabled]):hover{
  background:rgba(255,255,255,.10) !important; color:#fff !important;
  transform:translateY(-1px);
}

/* ══ Step Flow ══ */
.vipRide__steps-wrap{ overflow:hidden; }
.vipRide__step{ display:flex; flex-direction:column; will-change:transform,opacity; }
.vipRide__step[hidden]{ display:none !important; }

.vipRide__stepNext{
  margin-top:4px; width:100%;
  background:var(--vip-gold) !important; color:#000 !important;
  border:none !important; border-radius:12px;
  padding:13px 16px; font-size:13px; font-weight:800;
  letter-spacing:.08em; text-transform:uppercase; cursor:pointer;
  box-shadow:0 6px 20px rgba(212,175,55,.3), 0 2px 6px rgba(0,0,0,.35);
  transition:opacity 200ms, transform 200ms, box-shadow 200ms;
  touch-action:manipulation;
}
.vipRide__stepNext[disabled]{
  background:rgba(212,175,55,.2) !important; color:rgba(255,255,255,.35) !important;
  box-shadow:none; cursor:not-allowed; pointer-events:none;
}
.vipRide__stepNext:not([disabled]):hover{ opacity:.9; transform:translateY(-1px); box-shadow:0 12px 40px rgba(212,175,55,.45); }

.vipRide__stepBack{
  display:inline-flex; align-items:center; gap:5px;
  background:none; border:none; color:rgba(212,175,55,.8);
  font-size:12px; font-weight:600; cursor:pointer; padding:0 0 8px;
  transition:color 200ms; touch-action:manipulation;
}
.vipRide__stepBack:hover{ color:var(--vip-gold); }

/* ══ 3D Perspective Step Transitions ══ */
.vipRide__sheet{ perspective:1000px; }
@keyframes vip3DInRight{
  0%  { opacity:0; transform:translateX(40px) rotateY(-8deg) scale(.97); }
  100%{ opacity:1; transform:translateX(0)    rotateY(0deg)  scale(1);   }
}
@keyframes vip3DInLeft{
  0%  { opacity:0; transform:translateX(-40px) rotateY(8deg)  scale(.97); }
  100%{ opacity:1; transform:translateX(0)     rotateY(0deg)  scale(1);   }
}
@keyframes vipCardIn{
  from{ opacity:0; transform:translateY(20px) scale(.96); }
  to{   opacity:1; transform:translateY(0)     scale(1);   }
}
.vipRide__step{ transform-style:preserve-3d; }
.vipRide__step.is-entering      { animation:vip3DInRight 700ms cubic-bezier(0,.55,.45,1) both; }
.vipRide__step.is-entering-back { animation:vip3DInLeft  700ms cubic-bezier(0,.55,.45,1) both; }
