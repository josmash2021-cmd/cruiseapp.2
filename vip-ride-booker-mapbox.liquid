  function createPickupMarkerEl(){
    var el=document.createElement('div');
    el.className='vipRide__marker vipRide__marker--pickup';
    var inner=document.createElement('div');
    inner.className='vipRide__markerInner';
    // Full-circle bulb + bezier tail (matching gold_pin_renderer / ride_request_map)
    // Colors: #FFF8DC (cornsilk highlight), #E8C547 (mid gold), #B8860B (deep goldenrod)
    inner.innerHTML='<svg xmlns="http://www.w3.org/2000/svg" width="50" height="65" viewBox="0 0 50 65">'
      +'<defs>'
      // Drop shadow (black 0.32, blur 8, offset 0,3)
