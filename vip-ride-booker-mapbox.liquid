        function disableIOSZoom(){
          if(origContent.indexOf('maximum-scale') === -1){
            metaVP.setAttribute('content', origContent + ', maximum-scale=1');
          }
        }
        function enableIOSZoom(){
          metaVP.setAttribute('content', origContent);
        }
        document.addEventListener('focusin', function(e){
          if(e.target && e.target.tagName === 'INPUT') disableIOSZoom();
        });
        document.addEventListener('focusout', function(e){
          if(e.target && e.target.tagName === 'INPUT') setTimeout(enableIOSZoom, 300);
        });
      })();
      // Lock map on input focus
      root.querySelectorAll('input[type=text],input[type=date]').forEach(function(inp){
        inp.addEventListener('focus', lockMap);
        inp.addEventListener('blur', function(){ setTimeout(unlockMap, 400); });
      });

      attachAutocomplete(pickupEl,'pickup');
      if(dropoffEl) attachAutocomplete(dropoffEl,'dropoff');
      setClearVisibility(); syncPills(); validateCTA(null);

      // Locate button
      var locateBtn=document.getElementById('vipLocate-{{ section.id }}');
      function reverseGeocode(lat,lng,callback){
        var url='https://api.mapbox.com/geocoding/v5/mapbox.places/'
          +lng+','+lat+'.json?access_token='+encodeURIComponent(MAPBOX_TOKEN)
          +'&limit=1&language='+(currentLang==='es'?'es':'en');
        fetch(url)
          .then(function(r){ return r.json(); })
          .then(function(data){
            if(data.features&&data.features[0]) callback(data.features[0].place_name);
            else callback(null);
          })
          .catch(function(){ callback(null); });
      }
      function doGeolocate(onSuccess,onError){
        navigator.geolocation.getCurrentPosition(
          function(pos){
            var lat=pos.coords.latitude, lng=pos.coords.longitude;
            map.flyTo({center:[lng,lat],zoom:15,pitch:0,bearing:0,duration:2200,easing:function(t){var t1=t-1;return t1*t1*t1+1;}});
            if(pickupMarker){ pickupMarker.remove(); pickupMarker=null; }
            pickupMarker=new mapboxgl.Marker({element:createPickupMarkerEl(),anchor:'bottom'})
              .setLngLat([lng,lat]).addTo(map);
            reverseGeocode(lat,lng,function(placeName){
              if(placeName){
                pickupEl.value=placeName;
                pickupPlace={label:placeName,lat:lat,lng:lng};
                afterInputChange();
              }
              if(onSuccess) onSuccess();
            });
          },
          function(){ if(onError) onError(); },
          {timeout:10000,enableHighAccuracy:true}
        );
      }
      if(navigator.geolocation){
        if(locateBtn) locateBtn.classList.add('is-locating');
        doGeolocate(
          function(){ if(locateBtn) locateBtn.classList.remove('is-locating'); },
          function(){ if(locateBtn) locateBtn.classList.remove('is-locating'); }
        );
        if(locateBtn){
          locateBtn.addEventListener('click',function(){
            locateBtn.classList.add('is-locating');
            doGeolocate(
              function(){ locateBtn.classList.remove('is-locating'); },
              function(){ locateBtn.classList.remove('is-locating'); }
            );
          });
        }
      } else if(locateBtn){ locateBtn.style.display='none'; }
    }catch(err){
      console.error('[VIP Ride] Maps init error:',err);
    }
  }

  initMapbox();

})();
</script>

