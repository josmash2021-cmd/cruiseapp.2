/* Step indicator dots */
.vipRide__stepDots{
  display:flex; gap:5px; justify-content:center; margin-bottom:8px;
}
.vipRide__stepDot{
  width:5px; height:5px; border-radius:99px;
  background:rgba(255,255,255,.2);
  transition:all 300ms ease;
}
.vipRide__stepDot.is-active{ width:18px; background:var(--vip-gold); }
