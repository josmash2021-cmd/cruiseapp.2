  // ══ AUTOCOMPLETE VIA MAPBOX GEOCODING ══
  var _suggestionContainers=[];
  var _acDebounceTimers={};
  var _acSessionToken=crypto.randomUUID ? crypto.randomUUID() : (Date.now()+''+Math.random()).replace('.','');
  function closeSuggestions(){
    _suggestionContainers.forEach(function(c){ c.style.display='none'; });
  }

  function attachAutocomplete(inputEl,which){
    var field=inputEl.closest('.vipRide__field');
    var container=document.createElement('div');
    container.className='vipRide__suggestions';
    field.appendChild(container);
    _suggestionContainers.push(container);

    inputEl.addEventListener('input',function(){
      clearTimeout(_acDebounceTimers[which]);
      var query=inputEl.value.trim();
      if(query.length<3){ container.style.display='none'; return; }
      _acDebounceTimers[which]=setTimeout(function(){
        var center=map?map.getCenter():{lng:defaultLng,lat:defaultLat};
        // Use Mapbox Search Box API v1 for higher-quality verified addresses
        var url='https://api.mapbox.com/search/searchbox/v1/suggest'
          +'?q='+encodeURIComponent(query)
          +'&access_token='+encodeURIComponent(MAPBOX_TOKEN)
          +'&session_token='+_acSessionToken
          +'&language='+(currentLang==='es'?'es':'en')
          +'&limit=8'
          +'&types=address,poi,street,place'
          +'&proximity='+center.lng+','+center.lat;
        fetch(url)
          .then(function(r){ return r.json(); })
          .then(function(data){
            container.innerHTML='';
            if(!data.suggestions||!data.suggestions.length){ container.style.display='none'; return; }
            data.suggestions.forEach(function(sug){
              var item=document.createElement('div');
              item.className='vipRide__suggestion';
              var main=sug.name||sug.full_address||'';
              var sub=sug.full_address||sug.place_formatted||'';
              // Don't repeat main in sub
              if(sub.indexOf(main)===0) sub=sub.substring(main.length).replace(/^[\s,]+/,'');
              var iconSvg;
              if(sug.feature_type==='poi'){
                iconSvg='<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="4" width="12" height="10" rx="1.5" fill="currentColor"/><rect x="5" y="1" width="6" height="5" rx="1" fill="currentColor" opacity=".6"/></svg>';
              } else {
                iconSvg='<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 1C5.24 1 3 3.24 3 6c0 3.75 5 9 5 9s5-5.25 5-9c0-2.76-2.24-5-5-5z" fill="currentColor"/><circle cx="8" cy="6" r="2" fill="#000" opacity=".3"/></svg>';
              }
              item.innerHTML='<span class="vipRide__suggestionIcon">'+iconSvg+'</span>'
                +'<span class="vipRide__suggestionText"><span class="vipRide__suggestionMain">'+main+'</span>'
                +(sub?'<span class="vipRide__suggestionSub">'+sub+'</span>':'')+'</span>';
              item.addEventListener('click',function(){
                // Retrieve full details (exact coordinates) from Search Box API
                if(sug.mapbox_id){
                  var rUrl='https://api.mapbox.com/search/searchbox/v1/retrieve/'+sug.mapbox_id
                    +'?access_token='+encodeURIComponent(MAPBOX_TOKEN)
                    +'&session_token='+_acSessionToken;
                  fetch(rUrl)
                    .then(function(r){ return r.json(); })
                    .then(function(rData){
                      if(rData.features&&rData.features[0]){
                        var feat=rData.features[0];
                        var coords=feat.geometry.coordinates;
                        var lng=coords[0], lat=coords[1];
                        var name=feat.properties.full_address||feat.properties.name||sug.full_address||sug.name;
                        inputEl.value=name;
                        container.style.display='none';
                        var obj={label:name,lat:lat,lng:lng};
                        if(which==='pickup')  pickupPlace=obj;
                        if(which==='dropoff') dropoffPlace=obj;
                        inputEl.blur();
                        afterInputChange(); setMarker(which,lat,lng); computeRoute();
                        // Refresh session token for next search session
                        _acSessionToken=crypto.randomUUID ? crypto.randomUUID() : (Date.now()+''+Math.random()).replace('.','');
                      }
                    })
                    .catch(function(){});
                }
              });
              container.appendChild(item);
            });
            container.style.display='block';
          })
          .catch(function(){ container.style.display='none'; });
      },300);
    });

    inputEl.addEventListener('focus',function(){
      if(container.children.length>0) container.style.display='block';
    });
    document.addEventListener('click',function(e){
      if(!inputEl.contains(e.target)&&!container.contains(e.target)){
        container.style.display='none';
      }
    });
  }

  // ══ MAPBOX ROUTE DRAWING ══
  function clearRoute(){
    if(!map) return;
    try{
      if(map.getLayer('route-glow'))  map.removeLayer('route-glow');
      if(map.getLayer('route-line'))  map.removeLayer('route-line');
      if(map.getSource('route'))      map.removeSource('route');
    }catch(e){}
  }
  function drawRoute(geometry){
    clearRoute();
    if(!map||!geometry) return;
    map.addSource('route',{type:'geojson',data:{type:'Feature',geometry:{type:'LineString',coordinates:[geometry.coordinates[0]]}},lineMetrics:true});
    // Glow layer
    map.addLayer({
      id:'route-glow', type:'line', source:'route',
      layout:{'line-cap':'round','line-join':'round'},
      paint:{'line-color':'#D4AF37','line-width':16,'line-opacity':0.2,'line-blur':12}
    });
    // Main line with gradient
    map.addLayer({
      id:'route-line', type:'line', source:'route',
      layout:{'line-cap':'round','line-join':'round'},
      paint:{
        'line-width':5,
        'line-opacity':0.92,
        'line-gradient':[
          'interpolate',['linear'],['line-progress'],
          0,'#D4AF37',
          0.5,'#FFD700',
          1,'#E8C547'
        ]
      }
    });
    // Animate drawing
    var coords=geometry.coordinates;
    var total=coords.length;
    var idx=0;
    var step=Math.max(1,Math.ceil(total/180));
    var lastTime=0;
    function tick(ts){
      if(!lastTime) lastTime=ts;
      var delta=ts-lastTime;
      if(delta>=12){ // ~80fps cap for buttery smooth
        idx=Math.min(idx+step,total);
        var src=map.getSource('route');
        if(src) src.setData({type:'Feature',geometry:{type:'LineString',coordinates:coords.slice(0,idx)}});
        lastTime=ts;
      }
      if(idx<total) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  // ══ MODE TOGGLE FUNCTIONS ══
  function setMode(mode) {
    currentMode = mode;
    modeBtns.forEach(function(btn) {
      if(btn.getAttribute('data-mode') === mode) btn.classList.add('is-active');
      else btn.classList.remove('is-active');
    });
    if(propBookingType) propBookingType.value = mode;
    var formEl = root.querySelector('.vipRide__form');
    if(formEl) formEl.setAttribute('data-vipride-mode', mode);
    
    if(mode === 'hourly') {
      if(dropoffField) dropoffField.hidden = true;
      if(hoursField) hoursField.hidden = false;
      if(dropoffPill) dropoffPill.parentElement.hidden = true;
      if(pricesTitle) pricesTitle.textContent = t('chooseHourly');
      if(pickupLabel) pickupLabel.textContent = t('serviceLocationLabel');
      if(dropoffEl) {
        dropoffEl.value = '';
        dropoffPlace = null;
        if(dropoffMarker){ dropoffMarker.remove(); dropoffMarker=null; }
      }
      clearRoute();
      routeDurationSec = null;
      if(routeEstimate) routeEstimate.hidden = true;
    } else {
      if(dropoffField) dropoffField.hidden = false;
      if(hoursField) hoursField.hidden = true;
      if(dropoffPill) dropoffPill.parentElement.hidden = false;
      if(pricesTitle) pricesTitle.textContent = t('chooseRide');
      if(pickupLabel) pickupLabel.textContent = t('pickupLabel');
    }
    if(currentStep !== 1) goToStep(1, 'back');
    updateCardPrices();
    afterInputChange();
  }

  modeBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      setMode(btn.getAttribute('data-mode'));
    });
  });

  // ══ HOURS SELECTOR FUNCTIONS ══
  function updateHoursDisplay() {
    if(hoursValueEl) hoursValueEl.textContent = currentHours;
    if(hoursInput) hoursInput.value = currentHours;
    if(hoursMinusBtn) hoursMinusBtn.disabled = currentHours <= MIN_HOURS;
    if(hoursPlusBtn) hoursPlusBtn.disabled = currentHours >= MAX_HOURS;
    updateCardPrices();
    afterInputChange();
  }

  if(hoursMinusBtn) {
    hoursMinusBtn.addEventListener('click', function() {
      if(currentHours > MIN_HOURS) { currentHours--; updateHoursDisplay(); }
    });
  }
  if(hoursPlusBtn) {
    hoursPlusBtn.addEventListener('click', function() {
      if(currentHours < MAX_HOURS) { currentHours++; updateHoursDisplay(); }
    });
  }

  function vipScrollTo(el){
    if(!el) return;
    if(window.innerWidth>=900){
      var container=root.querySelector('[data-vipride-sheet]');
      if(container){
        var targetTop=el.offsetTop-20;
        container.scrollTo({top:targetTop,behavior:'smooth'});
      }
      return;
    }
    var rect=el.getBoundingClientRect();
    var absTop=rect.top+window.pageYOffset-20;
    window.scrollTo({top:absTop,behavior:'smooth'});
  }

  function openAccordion(doScroll){
    if(!slotPicker) return;
    slotPicker.removeAttribute('hidden');
    slotPicker.getBoundingClientRect();
    slotPicker.classList.add('is-open');
    if(timeTrigger) timeTrigger.setAttribute('aria-expanded','true');
    accordionOpen=true;
    if(doScroll && window.innerWidth<900 && timeField){
      requestAnimationFrame(function(){
        requestAnimationFrame(function(){ vipScrollTo(timeField); });
      });
    }
  }
  function closeAccordion(){
    if(!slotPicker) return;
    slotPicker.classList.remove('is-open');
    if(timeTrigger) timeTrigger.setAttribute('aria-expanded','false');
    accordionOpen=false;
    slotPicker.addEventListener('transitionend',function h(){
      if(!accordionOpen) slotPicker.setAttribute('hidden','');
      slotPicker.removeEventListener('transitionend',h);
    });
  }
  function toggleAccordion(){
    if(accordionOpen) closeAccordion(); else openAccordion(true);
  }
  if(timeTrigger) timeTrigger.addEventListener('click',toggleAccordion);

  var PERIOD_LABELS = [
    { labelKey:'morning',   from:6,  to:12 },
    { labelKey:'afternoon', from:12, to:17 },
    { labelKey:'evening',   from:17, to:20 },
    { labelKey:'night',     from:20, to:22 }
  ];

  function buildSlotPicker(dateStr){
    if(!slotPicker) return;
    var inner=slotPicker.querySelector('.vipRide__timeAccordion__inner');
    if(!inner) return;
    var bookedSet=new Set(
      ALL_BOOKED
        .filter(function(s){return typeof s==='string'&&s.startsWith(dateStr);})
        .map(function(s){return s.length>=16?s.slice(11,16):s.slice(0,5);})
    );
    var now=new Date();
    var todayStr=now.getFullYear()+'-'+pad2(now.getMonth()+1)+'-'+pad2(now.getDate());
    var isToday=dateStr===todayStr;
    var minHHMM=isToday
      ? toHHMM(roundUpToStep(new Date(Date.now()+MIN_LEAD_MINUTES*60000),SLOT_STEP_M))
      : '00:00';
    inner.innerHTML='';
    PERIOD_LABELS.forEach(function(period){
      var slots=[];
      for(var h=period.from;h<period.to;h++){
        for(var m=0;m<60;m+=SLOT_STEP_M){
          var hhmm=pad2(h)+':'+pad2(m);
          var isBooked=bookedSet.has(hhmm);
          var isPast=isToday&&hhmm<minHHMM;
          if(!isBooked&&!isPast) slots.push({hhmm:hhmm});
        }
      }
      if(!slots.length) return;
      var sec=document.createElement('div');
      sec.className='vipRide__slotSection';
      var title=document.createElement('p');
      title.className='vipRide__slotSectionTitle';
      title.textContent=t(period.labelKey);
      sec.appendChild(title);
      var grid=document.createElement('div');
      grid.className='vipRide__slotGrid';
      slots.forEach(function(slot){
        var btn=document.createElement('button');
        btn.type='button';
        btn.textContent=slot.hhmm;
        btn.className='vipRide__slot';
        btn.addEventListener('click',function(){
          slotPicker.querySelectorAll('.vipRide__slot--active')
            .forEach(function(b){b.classList.remove('vipRide__slot--active');});
          btn.classList.add('vipRide__slot--active');
          timeEl.value=slot.hhmm;
          if(slotDisplay){
            slotDisplay.textContent=slot.hhmm;
            slotDisplay.classList.add('has-value');
          }
          afterInputChange();
          if(window.innerWidth<900) closeAccordion();
        });
        grid.appendChild(btn);
      });
      sec.appendChild(grid);
      inner.appendChild(sec);
    });
    if(slotHint) slotHint.style.display='none';
  }

  function resetSlotPicker(){
    if(slotPicker){
      var inner=slotPicker.querySelector('.vipRide__timeAccordion__inner');
      if(inner){
        inner.innerHTML='';
        if(slotHint){ inner.appendChild(slotHint); slotHint.style.display=''; }
      }
    }
    closeAccordion();
    if(slotDisplay){ slotDisplay.textContent='Select a time slot'; slotDisplay.classList.remove('has-value'); }
    timeEl.value='';
  }

  function syncPills(){
    if(pickupPill)  pickupPill.textContent=pickupEl.value.trim()||'{{ section.settings.pickup_pill_default }}';
    if(dropoffPill) dropoffPill.textContent=dropoffEl.value.trim()||'{{ section.settings.dropoff_pill_default }}';
  }
  function syncProps(sel){
    if(propPickup)  propPickup.value=pickupEl.value.trim();
    if(propDropoff) propDropoff.value=currentMode === 'hourly' ? '' : dropoffEl.value.trim();
    if(propHours)   propHours.value=currentMode === 'hourly' ? currentHours : '';
    if(propDate)    propDate.value=dateEl.value;
    if(propTime)    propTime.value=timeEl.value;
    if(propVehicle) propVehicle.value=sel?sel.title||'' : '';
    if(propPrice)   propPrice.value=sel?sel.price||'' : '';
  }
  function setClearVisibility(){
    var pc=root.querySelector('[data-vipride-clear="pickup"]');
    var dc=root.querySelector('[data-vipride-clear="dropoff"]');
    if(pc) pc.style.display=pickupEl.value.trim()?'block':'none';
    if(dc) dc.style.display=dropoffEl.value.trim()?'block':'none';
  }
  function updateSeePricesBtn(){
    var locReady;
    if(currentMode === 'hourly') {
      locReady = pickupEl.value.trim().length > 0;
    } else {
      locReady = pickupEl.value.trim().length > 0 && dropoffEl.value.trim().length > 0;
    }
    if(step1NextBtn) step1NextBtn.disabled = !locReady;
    var dtReady = locReady && dateEl.value && timeEl.value;
    if(seePricesBtn){
      seePricesBtn.disabled = !dtReady;
      if(currentMode === 'ride' && pickupEl.value.trim().length > 0 && dropoffEl.value.trim().length === 0){
        seePricesBtn.textContent = currentLang === 'es' ? 'Agrega destino para ver precios' : 'Add destination to see prices';
      } else {
        seePricesBtn.textContent = t('seePrices');
      }
    }
  }
  function validateCTA(sel){
    var ok;
    if(currentMode === 'hourly') {
      ok = pickupEl.value.trim() && timeEl.value && !!sel;
    } else {
      ok = pickupEl.value.trim() && dropoffEl.value.trim() && timeEl.value && !!sel;
    }
    ctaBtn.disabled=!ok;
    if(checkoutBtn) checkoutBtn.disabled=!ok;
    if(form) form.hidden = !sel;
    if(ok){
      if(hint) hint.style.display='none';
      var priceText = sel && sel.price ? ' — ' + sel.price : '';
      ctaBtn.textContent='{{ section.settings.cta_default_text }}' + priceText;
      if(checkoutBtn) checkoutBtn.textContent='Checkout' + priceText;
    } else {
      if(hint) hint.style.display='none';
      ctaBtn.textContent='{{ section.settings.cta_default_text }}';
      if(checkoutBtn) checkoutBtn.textContent='Checkout';
    }
  }
  function afterInputChange(){
    setClearVisibility(); syncPills(); syncProps(selectedRide);
    updateSeePricesBtn(); validateCTA(selectedRide);
    var locReady = currentMode === 'hourly'
      ? pickupEl.value.trim().length > 0
      : pickupEl.value.trim().length > 0 && dropoffEl.value.trim().length > 0;
    if(step1NextBtn) step1NextBtn.disabled = !locReady;
    if(currentStep === 2 && locReady && dateEl.value && timeEl.value){
      if(routeDurationSec){
        updateCardPrices(routeDurationSec);
      } else {
        computeRoute();
        updateCardPrices();
      }
      goToStep(3, 'forward');
      setTimeout(function(){
        var firstAvail=cards.find(function(c){return !c.disabled&&!c.getAttribute('data-disabled');});
        if(!selectedRide&&firstAvail) selectCard(firstAvail);
      }, 200);
    }
  }

  function fitRouteBounds(){
    if(!map||!pickupPlace||!dropoffPlace) return;
    var bounds=new mapboxgl.LngLatBounds();
    bounds.extend([pickupPlace.lng,pickupPlace.lat]);
    bounds.extend([dropoffPlace.lng,dropoffPlace.lat]);
    var mapEl = document.getElementById('vipRideMap-{{ section.id }}');
    var mapH = mapEl ? mapEl.offsetHeight : window.innerHeight;
    var sheetH = sheet ? sheet.offsetHeight : 240;
    var padBottom = Math.min(sheetH + 30, mapH * 0.55);
    // First fit bounds flat, then cinematic tilt
    map.fitBounds(bounds, {
      padding:{top:80, right:50, bottom:padBottom, left:50},
      pitch:0,
      bearing:0,
      duration:2200,
      maxZoom:16,
      easing:function(t){ var t1=t-1; return t1*t1*t1+1; }
    });
    // Smooth cinematic tilt — wait for fitBounds to fully settle, then ease in gradually
    map.once('moveend', function(){
      // Small pause before starting tilt for visual rest
      setTimeout(function(){
        var startPitch=0, endPitch=50;
        var startBearing=0, endBearing=-10;
        var dur=4000; // 4 seconds total
        var startTime=null;
        function smoothTilt(ts){
          if(!startTime) startTime=ts;
          var elapsed=ts-startTime;
          var t=Math.min(elapsed/dur,1);
          // Smooth ease-out (decelerate) — feels natural
          var ease=1-Math.pow(1-t,4);
          map.jumpTo({
            pitch:startPitch+(endPitch-startPitch)*ease,
            bearing:startBearing+(endBearing-startBearing)*ease
          });
          if(t<1) requestAnimationFrame(smoothTilt);
        }
        requestAnimationFrame(smoothTilt);
      }, 300);
    });
  }

  function setMarker(which,lat,lng){
    if(which==='pickup'){
      if(pickupMarker){ pickupMarker.remove(); pickupMarker=null; }
      pickupMarker=new mapboxgl.Marker({element:createPickupMarkerEl(),anchor:'bottom'})
        .setLngLat([lng,lat]).addTo(map);
    }
    if(which==='dropoff'){
      if(dropoffMarker){ dropoffMarker.remove(); dropoffMarker=null; }
      dropoffMarker=new mapboxgl.Marker({element:createDropoffMarkerEl(),anchor:'bottom'})
        .setLngLat([lng,lat]).addTo(map);
    }
    unlockMap();
    if(currentMode === 'ride' && pickupPlace&&dropoffPlace&&map){
      fitRouteBounds();
    } else if(map){
      map.flyTo({center:[lng,lat],zoom:Math.max(defaultZoom,14),pitch:0,bearing:0,duration:2200,easing:function(t){var t1=t-1;return t1*t1*t1+1;}});
    }
  }

  function findBestVariant(blockId,targetCents){
    var variants=VEHICLE_VARIANTS[blockId];
    if(!variants||!variants.length) return null;
    var best=variants[0], bestDiff=Math.abs(variants[0].price-targetCents);
    for(var i=0;i<variants.length;i++){
      var diff=Math.abs(variants[i].price-targetCents);
      if(diff<bestDiff){ bestDiff=diff; best=variants[i]; }
    }
    return best;
  }

  function updateCardPrices(sec){
    if(!cards.length) return;
    cards.forEach(function(card){
      var rate = Number(card.getAttribute('data-rate')) || 0;
      var hourlyRate = Number(card.getAttribute('data-hourly-price')) || rate;
      var est, text, cents;
      if(currentMode === 'hourly') {
        est = currentHours * hourlyRate;
        text = moneyUSD(est);
        cents = Math.round(est * 100);
        var etaEl = card.querySelector('[data-vipride-eta]');
        if(etaEl) etaEl.textContent = currentHours + ' hours';
      } else {
        var durationSec = sec || routeDurationSec || 0;
        var hours = durationSec > 0 ? (durationSec / 3600) : 0;
        if(hours > 0 && rate > 0){
          est = hours * rate;
          text = moneyUSD(est);
          cents = Math.round(est * 100);
        } else {
          text = card.getAttribute('data-price') || '--';
          cents = Number(card.getAttribute('data-price-cents') || 0);
          est = cents / 100;
        }
        var etaEl = card.querySelector('[data-vipride-eta]');
        if(etaEl) etaEl.textContent = routeDurationSec ? formatMinutes(routeDurationSec) : '--';
      }
      card.setAttribute('data-price',text);
      card.setAttribute('data-price-cents',String(cents));
      var priceEl=card.querySelector('[data-vipride-card-price]');
      if(priceEl) priceEl.textContent=text;
    });
    if(selectedRide){
      var active=root.querySelector('.vipRide__rideCard.is-active');
      if(active){
        selectedRide.price=active.getAttribute('data-price')||'';
        selectedRide.priceCents=Number(active.getAttribute('data-price-cents')||0);
        syncProps(selectedRide); validateCTA(selectedRide);
      }
    }
  }

  function computeRoute(){
    if(currentMode === 'hourly') return;
    if(!pickupPlace||!dropoffPlace||!map) return;
    var req=++routeReq;
    var url='https://api.mapbox.com/directions/v5/mapbox/driving/'
      +pickupPlace.lng+','+pickupPlace.lat+';'
      +dropoffPlace.lng+','+dropoffPlace.lat
      +'?geometries=geojson&overview=full&access_token='+encodeURIComponent(MAPBOX_TOKEN);
    fetch(url)
      .then(function(r){ return r.json(); })
      .then(function(data){
        if(req!==routeReq) return;
        if(!data.routes||!data.routes[0]){
          routeDurationSec=null; if(routeEstimate) routeEstimate.hidden=true; return;
        }
        var route=data.routes[0];
        routeDurationSec=route.duration||null;
        var etaText=routeDurationSec?formatMinutes(routeDurationSec):'--';
        routeTimeText.textContent=etaText;
        if(routeEstimate) routeEstimate.hidden=false;
        drawRoute(route.geometry);
        requestAnimationFrame(function(){ fitRouteBounds(); });
        updateCardPrices(routeDurationSec);
        if(currentStep === 3) validateCTA(selectedRide);
      })
      .catch(function(err){
        console.warn('[VIP Ride] Directions error:',err);
      });
  }

  function selectCard(card){
    if(!card) return;
    cards.forEach(function(c){c.classList.remove('is-active');});
    card.classList.add('is-active');
    selectedRide={
      title:      card.getAttribute('data-title')||'',
      price:      card.getAttribute('data-price')||'',
      priceCents: Number(card.getAttribute('data-price-cents')||0),
      variantId:  card.getAttribute('data-variant-id')||'',
      blockId:    card.getAttribute('data-block-id')||''
    };
    if(bookingVariant&&selectedRide.variantId) bookingVariant.value=selectedRide.variantId;
    syncProps(selectedRide); validateCTA(selectedRide);
  }

  async function doCheckout(triggerBtn){
    if(!selectedRide){ alert(t('chooseVehicle')); return; }
    if(!timeEl.value){ alert(t('selectTime')); return; }
    var cents=Number(selectedRide.priceCents)||0;
    if(cents<=0){
      cents=Math.round(
        Number(String(selectedRide.price||'').replace(/[^0-9.]/g,''))*100
      )||0;
    }
    if(cents<=0){ alert(t('enterLocation')); return; }
    var pickup=pickupEl.value.trim();
    var dropoff=currentMode === 'hourly' ? '' : dropoffEl.value.trim();
    if(!pickup){ alert(t('enterLocation')); return; }
    if(currentMode === 'ride' && !dropoff){ alert(t('enterPickupDestination')); return; }
    var priceReadable=moneyUSD(cents/100);
    var bestVariant=findBestVariant(selectedRide.blockId,cents);
    var variantId, quantity;
    if(bestVariant&&Math.abs(bestVariant.price-cents)<100){
      variantId=bestVariant.id; quantity=1;
    } else {
      variantId=window.__VIP_CENT_VARIANT_ID__; quantity=cents;
    }
    var savedText=triggerBtn.textContent;
    triggerBtn.disabled=true; ctaBtn.disabled=true;
    if(checkoutBtn) checkoutBtn.disabled=true;
    triggerBtn.textContent=t('processing');
    try{
      await fetch('/cart/clear.js',{method:'POST'});
      var props = {
        Pickup:pickup, Date:dateEl.value, Time:timeEl.value,
        Vehicle:selectedRide.title||'',
        'Estimated Price':priceReadable,
        'Booking Type': currentMode === 'hourly' ? 'Hourly Service' : 'Point to Point'
      };
      if(currentMode === 'hourly') {
        props['Hours'] = currentHours;
        props['Service Type'] = 'Hourly Chauffeur Service';
      } else {
        props.Dropoff = dropoff;
      }
      var res=await fetch('/cart/add.js',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({
          id:variantId, quantity:quantity,
          properties: props
        })
      });
      if(!res.ok){
        var err=await res.json().catch(function(){return {};});
        throw new Error(err.description||'add to cart failed');
      }
      window.location.href='/checkout';
    }catch(err){
      console.error('[VIP Ride] checkout error:',err);
      alert(t('checkout') + ': ' + err.message);
      triggerBtn.textContent=savedText;
      triggerBtn.disabled=false; ctaBtn.disabled=false;
      if(checkoutBtn) checkoutBtn.disabled=false;
      validateCTA(selectedRide);
    }
  }

