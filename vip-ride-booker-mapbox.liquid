  function goToStep(n, dir){
    var prev = root.querySelector('[data-vipride-step-panel="'+currentStep+'"]');
    var next = root.querySelector('[data-vipride-step-panel="'+n+'"]');
    if(!next || n === currentStep) return;
    var enterClass = dir === 'back' ? 'is-entering-back' : 'is-entering';
    currentStep = n;
    if(sheet) sheet.setAttribute('data-vipride-step', String(n));
    updateStepDots();
    // Close any open suggestions
    closeSuggestions();
    if(prev){
      prev.style.transition = 'opacity 280ms ease-in, transform 280ms ease-in';
      prev.style.opacity = '0';
      prev.style.transform = dir === 'back' ? 'translateX(16px)' : 'translateX(-16px)';
      setTimeout(function(){
        prev.hidden = true;
        prev.style.transition = '';
        prev.style.opacity = '';
        prev.style.transform = '';
        next.hidden = false;
        next.classList.remove('is-entering','is-entering-back');
        void next.offsetWidth;
        next.classList.add(enterClass);
      }, 280);
    } else {
      next.hidden = false;
      next.classList.remove('is-entering','is-entering-back');
      void next.offsetWidth;
      next.classList.add(enterClass);
    }
  }

